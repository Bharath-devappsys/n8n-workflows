     rootMargin: '0px',\\n          threshold: 0.1,\\n        }\\n      );\\n\\n      observer.observe(img);\\n\\n      // Cleanup observer on unmount\\n      return () => {\\n        if (img) {\\n          observer.unobserve(img);\\n        }\\n      };\\n    } else if (thumbnailUrl === '/placeholder-image.jpg') {\\n        // If it's a placeholder, consider it loaded immediately for skeleton purposes\\n        setImageLoaded(true);\\n    }\\n  }, [thumbnailUrl]);\\n\\n  const handleMouseEnter = () => setIsHovered(true);\\n  const handleMouseLeave = () => setIsHovered(false);\\n\\n  if (isLoading) {\\n    return (\\n      <div className=\\\"relative w-full h-64 sm:h-72 md:h-80 rounded-lg overflow-hidden shadow-lg bg-secondary dark:bg-secondary-dark animate-pulse\\\">\\n        <SkeletonLoader className=\\\"w-full h-full\\\" />\\n        <ShimmerEffect />\\n        <div className=\\\"absolute bottom-2 left-2 right-2 p-2 bg-black bg-opacity-50 rounded-md\\\">\\n          <div className=\\\"h-4 w-3/4 bg-gray-700 rounded mb-1\\\"></div>\\n          <div className=\\\"h-3 w-1/2 bg-gray-700 rounded\\\"></div>\\n        </div>\\n      </div>\\n    );\\n  }\\n\\n  if (isError) {\\n    return (\\n      <div className=\\\"w-full h-64 sm:h-72 md:h-80 rounded-lg overflow-hidden shadow-lg bg-secondary dark:bg-secondary-dark flex items-center justify-center\\\">\\n        <p className=\\\"text-red-500\\\">Error loading</p>\\n      </div>\\n    );\\n  }\\n\\n  return (\\n    <div\\n      ref={imgRef}\\n      className=\\\"relative w-full h-64 sm:h-72 md:h-80 rounded-lg overflow-hidden shadow-lg bg-secondary dark:bg-secondary-dark transition-transform duration-300 ease-in-out hover:scale-105 hover:shadow-xl cursor-pointer\\\"\\n      onMouseEnter={handleMouseEnter}\\n      onMouseLeave={handleMouseLeave}\\n    >\\n      <Link to={`/anime/${mal_id}`}>\\n        <img\\n          src={thumbnailUrl}\\n          alt={title}\\n          className={`w-full h-full object-cover transition-opacity duration-500 ${imageLoaded ? 'opacity-100' : 'opacity-0'}`}\\n          onLoad={() => setImageLoaded(true)} // This will fire when the image has loaded in the browser\\n          loading=\\\"lazy\\\"\\n        />\\n        {!imageLoaded && (\\n          <div className=\\\"absolute inset-0 bg-gradient-to-br from-gray-800 to-gray-900 animate-pulse\\\">\\n            <ShimmerEffect />\\n          </div>\\n        )}\\n      </Link>\\n\\n      {/* Info Overlay on Hover */}\\n      <div\\n        className={[\\n          'absolute bottom-0 left-0 right-0 p-3 transition-opacity duration-300 ease-in-out',\\n          isHovered ? 'opacity-100 bg-black bg-opacity-70' : 'opacity-0 bg-black bg-opacity-50',\\n        ].join(' ')}\\n      >\\n        <h3 className=\\\"text-white font-bold text-sm sm:text-base mb-1 line-clamp-2\\\">\\n          {title}\\n        </h3>\\n        <div className=\\\"flex items-center justify-between text-xs sm:text-sm text-gray-300\\\">\\n          <span className=\\\"flex items-center\\\">\\n            <svg className=\\\"w-4 h-4 mr-1 fill-current text-yellow-400\\\" viewBox=\\\"0 0 24 24\\\">\\n              <path d=\\\"M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21 12 17.27z\\\"/>\\n            </svg>\\n            {score !== null ? score.toFixed(1) : 'N/A'}\\n          </span>\\n          <span className=\\\"px-2 py-1 bg-blue-600 rounded-sm text-white text-xs font-medium\\\">{status}</span>\\n        </div>\\n      </div>\\n\\n      {/* Watchlist Button - Visible on hover */}\\n      <div\\n        className={[\\n          'absolute top-2 right-2 z-10 transition-opacity duration-300 ease-in-out',\\n          isHovered ? 'opacity-100' : 'opacity-0 pointer-events-none',\\n        ].join(' ')}\\n      >\\n        <WatchlistButton animeId={mal_id} />\\n      </div>\\n    </div>\\n  );\\n};\\n\\nexport default ShowCard;\\n\",\n    \"src/components/ShowCard/WatchlistButton.jsx\": \"import React, { useState, useEffect } from 'react';\\nimport IconButton from '../IconButton.jsx';\\nimport '../assets/styles/global.css';\\n\\n// Mock function to simulate API call for adding/removing from watchlist\\nconst mockApiWatchlist = async (animeId, action) => {\\n  console.log(`API: Attempting to ${action} anime ${animeId} to watchlist.`);\\n  return new Promise((resolve) => {\\n    setTimeout(() => {\\n      // Simulate success response\\n      resolve({ success: true, animeId, action });\\n    }, 500);\\n  });\\n};\\n\\nconst WatchlistButton = ({ animeId }) => {\\n  // In a real application, this state would likely be managed globally (e.g., context or Zustand)\\n  // and fetched based on the user's actual watchlist.\\n  const [isAdded, setIsAdded] = useState(false);\\n  const [isLoading, setIsLoading] = useState(false);\\n\\n  // Placeholder for checking initial state of the button (e.g., from context)\\n  // For this example, we'll assume it's initially not added.\\n  useEffect(() => {\\n    // If you have a way to get the user's watchlist, you'd set initial state here.\\n    // For example:\\n    // const isInWatchlist = userWatchlist.some(item => item.mal_id === animeId);\\n    // setIsAdded(isInWatchlist);\\n    setIsAdded(false); // Default to false for this example\\n  }, [animeId]);\\n\\n  const handleClick = async () => {\\n    if (isLoading) return;\\n\\n    setIsLoading(true);\\n    const action = isAdded ? 'remove' : 'add';\\n\\n    try {\\n      const response = await mockApiWatchlist(animeId, action);\\n      if (response.success) {\\n        setIsAdded(!isAdded);\\n        // Optionally provide user feedback (toast notification, etc.)\\n        console.log(`Successfully ${action}ed anime ${animeId} to watchlist.`);\\n      } else {\\n        // Handle API error, e.g., show an error message\\n        console.error(`Failed to ${action} anime ${animeId} to watchlist.`);\\n      }\\n    } catch (error) {\\n      console.error(`Error during watchlist operation for anime ${animeId}:`, error);\\n      // Handle network errors, etc.\\n    } finally {\\n      setIsLoading(false);\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"relative group\\\">\\n      <IconButton\\n        iconName={isAdded ? 'bookmark_remove' : 'bookmark_add'}\\n        onClick={handleClick}\\n        aria-label={isAdded ? 'Remove from watchlist' : 'Add to watchlist'}\\n        disabled={isLoading}\\n        className={[\\n          'p-2 rounded-full transition-colors duration-200',\\n          isAdded\\n            ? 'bg-red-500 hover:bg-red-600 text-white'\\n            : 'bg-blue-500 hover:bg-blue-600 text-white',\\n          isLoading ? 'opacity-50 cursor-not-allowed' : '',\\n        ].join(' ')}\\n      />\\n      {/* Tooltip */}\\n      <span\\n        className={[\\n          'absolute -bottom-10 left-1/2 -translate-x-1/2 z-10 px-3 py-1 text-xs font-medium rounded-md whitespace-nowrap transition-opacity duration-300',\\n          isAdded ? 'bg-red-500' : 'bg-blue-500',\\n          isLoading ? 'hidden' : 'group-hover:opacity-100 opacity-0',\\n        ].join(' ')}\\n      >\\n        {isAdded ? 'Remove from Watchlist' : 'Add to Watchlist'}\\n      </span>\\n    </div>\\n  );\\n};\\n\\nexport default WatchlistButton;\\n\",\n    \"src/components/Carousel.jsx\": \"import React, { useRef, useState, useEffect } from 'react';\\nimport ShowCard from './ShowCard/ShowCard.jsx';\\nimport '../assets/styles/global.css';\\n\\nconst Carousel = ({ children }) => {\\n  const carouselRef = useRef(null);\\n  const [canScrollPrev, setCanScrollPrev] = useState(false);\\n  const [canScrollNext, setCanScrollNext] = useState(false);\\n  const [isDragging, setIsDragging] = useState(false);\\n  const [startX, setStartX] = useState(0);\\n  const [scrollLeft, setScrollLeft] = useState(0);\\n\\n  const updateScrollArrows = () => {\\n    if (carouselRef.current) {\\n      setCanScrollPrev(carouselRef.current.scrollLeft > 0);\\n      setCanScrollNext(\\n        carouselRef.current.scrollLeft <\\n          carouselRef.current.scrollWidth - carouselRef.current.clientWidth\\n      );\\n    }\\n  };\\n\\n  useEffect(() => {\\n    updateScrollArrows();\\n    window.addEventListener('resize', updateScrollArrows);\\n    return () => window.removeEventListener('resize', updateScrollArrows);\\n  }, [children]);\\n\\n  const handleScroll = () => {\\n    updateScrollArrows();\\n  };\\n\\n  const scrollPrev = () => {\\n    if (carouselRef.current) {\\n      carouselRef.current.scrollBy({ left: -carouselRef.current.offsetWidth, behavior: 'smooth' });\\n    }\\n  };\\n\\n  const scrollNext = () => {\\n    if (carouselRef.current) {\\n      carouselRef.current.scrollBy({ left: carouselRef.current.offsetWidth, behavior: 'smooth' });\\n    }\\n  };\\n\\n  // Dragging logic for touch devices\\n  const handleMouseDown = (e) => {\\n    setIsDragging(true);\\n    setStartX(e.pageX - carouselRef.current.offsetLeft);\\n    setScrollLeft(carouselRef.current.scrollLeft);\\n    carouselRef.current.style.cursor = 'grabbing';\\n    carouselRef.current.style.userSelect = 'none';\\n  };\\n\\n  const handleMouseLeave = () => {\\n    setIsDragging(false);\\n    carouselRef.current.style.cursor = 'grab';\\n    carouselRef.current.style.userSelect = 'auto';\\n  };\\n\\n  const handleMouseMove = (e) => {\\n    if (!isDragging) return;\\n    e.preventDefault();\\n    const x = e.pageX - carouselRef.current.offsetLeft;\\n    const walk = (x - scrollLeft) * 1.5; // Adjust multiplier for scroll sensitivity\\n    carouselRef.current.scrollLeft = scrollLeft - walk;\\n    updateScrollArrows();\\n  };\\n\\n  // Ensure touch events are also handled\\n  const handleTouchStart = (e) => {\\n    setIsDragging(true);\\n    setStartX(e.touches[0].pageX - carouselRef.current.offsetLeft);\\n    setScrollLeft(carouselRef.current.scrollLeft);\\n    carouselRef.current.style.cursor = 'grabbing';\\n    carouselRef.current.style.userSelect = 'none';\\n  };\\n\\n  const handleTouchEnd = () => {\\n    setIsDragging(false);\\n    carouselRef.current.style.cursor = 'grab';\\n    carouselRef.current.style.userSelect = 'auto';\\n  };\\n\\n  const handleTouchMove = (e) => {\\n    if (!isDragging) return;\\n    const x = e.touches[0].pageX - carouselRef.current.offsetLeft;\\n    const walk = (x - scrollLeft) * 1.5;\\n    carouselRef.current.scrollLeft = scrollLeft - walk;\\n    updateScrollArrows();\\n  };\\n\\n  return (\\n    <div className=\\\"relative w-full overflow-hidden group\\\">\\n      <div\\n        ref={carouselRef}\\n        className=\\\"flex overflow-x-auto space-x-4 pb-4 scrollbar-hide cursor-grab transition-all duration-300 ease-out\\\"\\n        onScroll={handleScroll}\\n        onMouseDown={handleMouseDown}\\n        onMouseLeave={handleMouseLeave}\\n        onMouseMove={handleMouseMove}\\n        onTouchStart={handleTouchStart}\\n        onTouchEnd={handleTouchEnd}\\n        onTouchMove={handleTouchMove}\\n        style={{ scrollSnapType: 'x mandatory' }}\\n      >\\n        {React.Children.map(children, (child, index) => (\\n          <div\\n            key={index}\\n            className=\\\"flex-shrink-0 w-full sm:w-1/2 md:w-1/3 lg:w-1/4\\\"\\n            style={{ scrollSnapAlign: 'start' }}\\n          >\\n            {child}\\n          </div>\\n        ))}\\n      </div>\\n\\n      {/* Navigation Arrows - Visible on Desktop/Hover */}\\n      <button\\n        onClick={scrollPrev}\\n        className={`absolute left-0 top-1/2 -translate-y-1/2 z-10 p-3 bg-white dark:bg-gray-800 rounded-full shadow-lg text-primary dark:text-white hover:bg-accent dark:hover:bg-accent-dark hover:text-white transition-opacity duration-300 ease-in-out group-hover:opacity-100 ${canScrollPrev ? 'opacity-70' : 'opacity-0 pointer-events-none'}`}\\n        aria-label=\\\"Previous slide\\\"\\n      >\\n        <span className=\\\"material-icons\\\">keyboard_arrow_left</span>\\n      </button>\\n      <button\\n        onClick={scrollNext}\\n        className={`absolute right-0 top-1/2 -translate-y-1/2 z-10 p-3 bg-white dark:bg-gray-800 rounded-full shadow-lg text-primary dark:text-white hover:bg-accent dark:hover:bg-accent-dark hover:text-white transition-opacity duration-300 ease-in-out group-hover:opacity-100 ${canScrollNext ? 'opacity-70' : 'opacity-0 pointer-events-none'}`}\\n        aria-label=\\\"Next slide\\\"\\n      >\\n        <span className=\\\"material-icons\\\">keyboard_arrow_right</span>\\n      </button>\\n    </div>\\n  );\\n};\\n\\nexport default Carousel;\\n\",\n    \"src/components/Footer.jsx\": \"import React from 'react';\\nimport { Link } from 'react-router-dom';\\nimport '../assets/styles/global.css';\\n\\nconst Footer = () => {\\n  const currentYear = new Date().getFullYear();\\n\\n  return (\\n    <footer className=\\\"bg-secondary dark:bg-secondary-dark text-primary dark:text-white py-6 px-4 mt-12\\\">\\n      <div className=\\\"container mx-auto flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0\\\">\\n        <div className=\\\"text-sm\\\">\\n          &copy; {currentYear} AniStudio. All rights reserved.\\n        </div>\\n        <div className=\\\"flex space-x-4 text-sm\\\">\\n          <Link to=\\\"/about\\\" className=\\\"hover:text-accent dark:hover:text-accent-dark transition-colors duration-200\\\">About Us</Link>\\n          <Link to=\\\"/privacy\\\" className=\\\"hover:text-accent dark:hover:text-accent-dark transition-colors duration-200\\\">Privacy Policy</Link>\\n          <Link to=\\\"/contact\\\" className=\\\"hover:text-accent dark:hover:text-accent-dark transition-colors duration-200\\\">Contact</Link>\\n        </div>\\n      </div>\\n    </footer>\\n  );\\n};\\n\\nexport default Footer;\\n\",\n    \"src/components/FilterPanel/FilterPanel.jsx\": \"import React, { useState, useEffect } from 'react';\\nimport MultiSelectCheckbox from './MultiSelectCheckbox.jsx';\\nimport Slider from './Slider.jsx';\\nimport Dropdown from '../Dropdown.jsx'; // Assuming a generic Dropdown component exists\\nimport '../assets/styles/global.css';\\n\\nconst FilterPanel = ({\\n  filters,\\n  onFilterChange,\\n  sortOrder,\\n  onSortChange,\\n}) => {\\n  const [currentFilters, setCurrentFilters] = useState(filters);\\n  const [currentSortOrder, setCurrentSortOrder] = useState(sortOrder);\\n\\n  // Update local state if external filters change\\n  useEffect(() => {\\n    setCurrentFilters(filters);\\n  }, [filters]);\\n\\n  useEffect(() => {\\n    setCurrentSortOrder(sortOrder);\\n  }, [sortOrder]);\\n\\n  const handleApplyFilters = () => {\\n    onFilterChange(currentFilters);\\n  };\\n\\n  const handleApplySort = () => {\\n    onSortChange(currentSortOrder);\\n  };\\n\\n  // Example filter options (these would likely come from an API or constants)\\n  const genreOptions = [\\n    { id: 'action', label: 'Action' },\\n    { id: 'adventure', label: 'Adventure' },\\n    { id: 'comedy', label: 'Comedy' },\\n    { id: 'drama', label: 'Drama' },\\n    { id: 'fantasy', label: 'Fantasy' },\\n    // ... more genres\\n  ];\\n\\n  const typeOptions = [\\n    { id: 'tv', label: 'TV' },\\n    { id: 'movie', label: 'Movie' },\\n    { id: 'ova', label: 'OVA' },\\n    { id: 'special', label: 'Special' },\\n  ];\\n\\n  const sortOptions = [\\n    { id: 'score', label: 'Score' },\\n    { id: 'popularity', label: 'Popularity' },\\n    { id: 'title', label: 'Alphabetical' },\\n    { id: 'start_date', label: 'Release Date' },\\n    { id: 'members', label: 'Members' },\\n  ];\\n\\n  const handleGenreChange = (selectedGenres) => {\\n    setCurrentFilters((prev) => ({ ...prev, genres: selectedGenres }));\\n  };\\n\\n  const handleTypeChange = (selectedTypes) => {\\n    setCurrentFilters((prev) => ({ ...prev, types: selectedTypes }));\\n  };\\n\\n  const handleYearChange = (selectedYearRange) => {\\n    setCurrentFilters((prev) => ({ ...prev, year: selectedYearRange }));\\n  };\\n\\n  // Assuming Slider can handle a range object like { min: 1990, max: 2023 }\\n  const handleRatingChange = (selectedRatingRange) => {\\n    setCurrentFilters((prev) => ({ ...prev, rating: selectedRatingRange }));\\n  };\\n\\n  const handleSortDropdownChange = (selectedValue) => {\\n    setCurrentSortOrder(selectedValue);\\n  };\\n\\n  return (\\n    <div className=\\\"p-4 rounded-lg shadow-md bg-secondary dark:bg-secondary-dark space-y-6\\\">\\n      <h2 className=\\\"text-2xl font-bold text-primary dark:text-white mb-4\\\">Filters & Sort</h2>\\n\\n      {/* Genre Filter */}\\n      <div>\\n        <MultiSelectCheckbox\\n          label=\\\"Genres\\\"\\n          options={genreOptions}\\n          selectedOptions={currentFilters.genres || []}\\n          onChange={handleGenreChange}\\n        />\\n      </div>\\n\\n      {/* Type Filter */}\\n      <div>\\n        <MultiSelectCheckbox\\n          label=\\\"Type\\\"\\n          options={typeOptions}\\n          selectedOptions={currentFilters.types || []}\\n          onChange={handleTypeChange}\\n        />\\n      </div>\\n\\n      {/* Year Filter */}\\n      <div>\\n        <Slider\\n          label=\\\"Year Range\\\"\\n          min={1950} // Example min year\\n          max={new Date().getFullYear()} // Example max year (current year)\\n          initialValue={currentFilters.year || { min: 1990, max: 2020 }} // Example initial range\\n          onChange={handleYearChange}\\n        />\\n      </div>\\n\\n      {/* Rating Filter (Example: 1-10) */}\\n      <div>\\n        <Slider\\n          label=\\\"Rating\\\"\\n          min={1}\\n          max={10}\\n          step={0.5}\\n          initialValue={currentFilters.rating || { min: 6, max: 9 }}\\n          onChange={handleRatingChange}\\n        />\\n      </div>\\n\\n      {/* Sort Order Dropdown */}\\n      <div className=\\\"mt-6\\\">\\n        <Dropdown\\n          label=\\\"Sort By\\\"\\n          options={sortOptions}\\n          selectedValue={currentSortOrder}\\n          onChange={handleSortDropdownChange}\\n        />\\n      </div>\\n\\n      {/* Apply Buttons */}\\n      <div className=\\\"flex space-x-4 mt-8\\\">\\n        <button\\n          onClick={handleApplyFilters}\\n          className=\\\"px-4 py-2 bg-accent text-white font-semibold rounded-lg shadow-md hover:bg-accent-dark focus:outline-none focus:ring-2 focus:ring-accent focus:ring-opacity-75 transition-colors duration-200\\\"\\n        >\\n          Apply Filters\\n        </button>\\n        <button\\n          onClick={handleApplySort}\\n          className=\\\"px-4 py-2 bg-blue-500 text-white font-semibold rounded-lg shadow-md hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-opacity-75 transition-colors duration-200\\\"\\n        >\\n          Apply Sort\\n        </button>\\n      </div>\\n    </div>\\n  );\\n};\\n\\nexport default FilterPanel;\\n\",\n    \"src/components/FilterPanel/MultiSelectCheckbox.jsx\": \"import React, { useState, useEffect } from 'react';\\nimport '../assets/styles/global.css';\\n\\nconst MultiSelectCheckbox = ({\\n  label,\\n  options,\\n  selectedOptions,\\n  onChange,\\n}) => {\\n  const [isOpen, setIsOpen] = useState(false);\\n\\n  // Ensure local state reflects initial selectedOptions passed as prop\\n  useEffect(() => {\\n    // No explicit state update needed here if selectedOptions prop is the source of truth\\n    // The parent component manages the selectedOptions state.\\n  }, [selectedOptions]);\\n\\n  const handleCheckboxChange = (optionId) => {\\n    const newSelectedOptions = [...selectedOptions];\\n    if (newSelectedOptions.includes(optionId)) {\\n      const index = newSelectedOptions.indexOf(optionId);\\n      newSelectedOptions.splice(index, 1);\\n    } else {\\n      newSelectedOptions.push(optionId);\\n    }\\n    onChange(newSelectedOptions);\\n  };\\n\\n  // Get the labels of the currently selected options\\n  const selectedLabels = options\\n    .filter(option => selectedOptions.includes(option.id))\\n    .map(option => option.label)\\n    .join(', ');\\n\\n  return (\\n    <div className=\\\"relative\\\">\\n      <label className=\\\"block text-sm font-medium mb-2 text-primary dark:text-white\\\">\\n        {label}\\n      </label>\\n      <div\\n        className=\\\"p-2 rounded-lg bg-secondary dark:bg-secondary-dark border border-gray-700 cursor-pointer flex justify-between items-center transition-colors duration-200 hover:bg-accent-light dark:hover:bg-accent-dark-hover\\\"\\n        onClick={() => setIsOpen(!isOpen)}\\n      >\\n        <span className=\\\"text-sm text-gray-300 dark:text-gray-400 truncate mr-2\\\">\\n          {selectedLabels || `Select ${label}...`}\\n        </span>\\n        <span className=\\\"material-icons text-primary dark:text-white\\\">\\n          {isOpen ? 'arrow_drop_up' : 'arrow_drop_down'}\\n        </span>\\n      </div>\\n\\n      {isOpen && (\\n        <div className=\\\"absolute z-10 mt-1 w-full bg-secondary dark:bg-secondary-dark rounded-lg shadow-lg border border-gray-700 p-3\\\">\\n          {options.map(option => (\\n            <label key={option.id} className=\\\"flex items-center mb-2 text-primary dark:text-white\\\">\\n              <input\\n                type=\\\"checkbox\\\"\\n                checked={selectedOptions.includes(option.id)}\\n                onChange={() => handleCheckboxChange(option.id)}\\n                className=\\\"mr-2 h-4 w-4 rounded border-gray-700 text-accent focus:ring-accent\\\"\\n              />\\n              {option.label}\\n            </label>\\n          ))}\\n        </div>\\n      )}\\n    </div>\\n  );\\n};\\n\\nexport default MultiSelectCheckbox;\\n\",\n    \"src/components/FilterPanel/Slider.jsx\": \"import React, { useState, useEffect } from 'react';\\nimport '../assets/styles/global.css';\\n\\nconst Slider = ({\\n  label,\\n  min,\\n  max,\\n  step = 1,\\n  initialValue,\\n  onChange,\\n}) => {\\n  // State to manage the current range of the slider\\n  const [range, setRange] = useState(initialValue || { min: min, max: max });\\n\\n  // Update local state if the initialValue prop changes\\n  useEffect(() => {\\n    setRange(initialValue || { min: min, max: max });\\n  }, [initialValue, min, max]);\\n\\n  const handleMinChange = (e) => {\\n    const newMin = parseFloat(e.target.value);\\n    if (!isNaN(newMin) && newMin <= range.max) {\\n      const updatedRange = { ...range, min: newMin };\\n      setRange(updatedRange);\\n      onChange(updatedRange);\\n    }\\n  };\\n\\n  const handleMaxChange = (e) => {\\n    const newMax = parseFloat(e.target.value);\\n    if (!isNaN(newMax) && newMax >= range.min) {\\n      const updatedRange = { ...range, max: newMax };\\n      setRange(updatedRange);\\n      onChange(updatedRange);\\n    }\\n  };\\n\\n  // Ensure the slider visually updates correctly even if only input changes\\n  useEffect(() => {\\n    // This effect can be used to ensure visual sync if needed, though input handlers should manage state.\\n  }, [range]);\\n\\n  return (\\n    <div>\\n      <label className=\\\"block text-sm font-medium mb-2 text-primary dark:text-white\\\">\\n        {label}\\n      </label>\\n      <div className=\\\"flex items-center justify-between space-x-4 mb-4\\\">\\n        <input\\n          type=\\\"number\\\"\\n          value={range.min}\\n          onChange={handleMinChange}\\n          min={min}\\n          max={max}\\n          step={step}\\n          className=\\\"w-1/2 p-2 rounded-lg bg-secondary dark:bg-secondary-dark border border-gray-700 focus:outline-none focus:ring-2 focus:ring-accent text-sm\\\"\\n        />\\n        <span className=\\\"text-sm text-gray-500 dark:text-gray-400\\\">-</span>\\n        <input\\n          type=\\\"number\\\"\\n          value={range.max}\\n          onChange={handleMaxChange}\\n          min={min}\\n          max={max}\\n          step={step}\\n          className=\\\"w-1/2 p-2 rounded-lg bg-secondary dark:bg-secondary-dark border border-gray-700 focus:outline-none focus:ring-2 focus:ring-accent text-sm\\\"\\n        />\\n      </div>\\n      {/* Placeholder for a visual slider bar if a dedicated library is used */}\\n      {/* For now, we rely on the number inputs as the primary control */}\\n      <div className=\\\"relative h-2 bg-gray-600 rounded-full\\\">\\n        {/* This is a very basic representation. A full range slider component would involve more complex DOM manipulation or a library. */}\\n      </div>\\n    </div>\\n  );\\n};\\n\\nexport default Slider;\\n\",\n    \"src/components/Pagination.jsx\": \"import React from 'react';\\nimport '../assets/styles/global.css';\\n\\nconst Pagination = ({\\n  currentPage,\\n  totalPages,\\n  onPageChange,\\n}) => {\\n  if (totalPages <= 1) {\\n    return null; // Don't render pagination if there's only one page or no data\\n  }\\n\\n  const handlePrevClick = () => {\\n    if (currentPage > 1) {\\n      onPageChange(currentPage - 1);\\n    }\\n  };\\n\\n  const handleNextClick = () => {\\n    if (currentPage < totalPages) {\\n      onPageChange(currentPage + 1);\\n    }\\n  };\\n\\n  const handlePageNumberClick = (pageNumber) => {\\n    onPageChange(pageNumber);\\n  };\\n\\n  // Generate page numbers to display\\n  const pageNumbers = [];\\n  const maxPagesToShow = 5; // Maximum number of page numbers to show around the current page\\n  let startPage = Math.max(1, currentPage - Math.floor(maxPagesToShow / 2));\\n  let endPage = Math.min(totalPages, startPage + maxPagesToShow - 1);\\n\\n  if (endPage - startPage + 1 < maxPagesToShow) {\\n    startPage = Math.max(1, endPage - maxPagesToShow + 1);\\n  }\\n\\n  for (let i = startPage; i <= endPage; i++) {\\n    pageNumbers.push(i);\\n  }\\n\\n  return (\\n    <nav\\n      aria-label=\\\"Anime pagination\\\"\\n      className=\\\"flex justify-center items-center space-x-2 mt-8 mb-4 p-4 bg-secondary dark:bg-secondary-dark rounded-lg shadow-sm\\\"\\n    >\\n      {/* Previous Button */}\\n      <button\\n        onClick={handlePrevClick}\\n        disabled={currentPage === 1}\\n        className={[\\n          'px-3 py-2 rounded-md font-medium transition-colors duration-200',\\n          currentPage === 1\\n            ? 'bg-gray-300 dark:bg-gray-700 text-gray-500 cursor-not-allowed'\\n            : 'bg-accent hover:bg-accent-dark text-white hover:text-white',\\n        ].join(' ')}\\n      >\\n        Previous\\n      </button>\\n\\n      {/* Page Numbers */}\\n      {startPage > 1 && (\\n        <button\\n          onClick={() => handlePageNumberClick(1)}\\n          className=\\\"px-3 py-2 rounded-md font-medium transition-colors duration-200 hover:bg-accent-light dark:hover:bg-accent-dark-hover text-primary dark:text-white\\\"\\n        >\\n          1\\n        </button>\\n      )}\\n      {startPage > 2 && <span className=\\\"px-3 py-2 text-primary dark:text-white\\\">...</span>}\\n\\n      {pageNumbers.map((page) => (\\n        <button\\n          key={page}\\n          onClick={() => handlePageNumberClick(page)}\\n          className={[\\n            'px-3 py-2 rounded-md font-medium transition-colors duration-200',\\n            page === currentPage\\n              ? 'bg-accent dark:bg-accent-dark text-white'\\n              : 'hover:bg-accent-light dark:hover:bg-accent-dark-hover text-primary dark:text-white',\\n          ].join(' ')}\\n        >\\n          {page}\\n        </button>\\n      ))}\\n\\n      {endPage < totalPages && <span className=\\\"px-3 py-2 text-primary dark:text-white\\\">...</span>}\\n      {endPage < totalPages && (\\n        <button\\n          onClick={() => handlePageNumberClick(totalPages)}\\n          className=\\\"px-3 py-2 rounded-md font-medium transition-colors duration-200 hover:bg-accent-light dark:hover:bg-accent-dark-hover text-primary dark:text-white\\\"\\n        >\\n          {totalPages}\\n        </button>\\n      )}\\n\\n      {/* Next Button */}\\n      <button\\n        onClick={handleNextClick}\\n        disabled={currentPage === totalPages}\\n        className={[\\n          'px-3 py-2 rounded-md font-medium transition-colors duration-200',\\n          currentPage === totalPages\\n            ? 'bg-gray-300 dark:bg-gray-700 text-gray-500 cursor-not-allowed'\\n            : 'bg-accent hover:bg-accent-dark text-white hover:text-white',\\n        ].join(' ')}\\n      >\\n        Next\\n      </button>\\n    </nav>\\n  );\\n};\\n\\nexport default Pagination;\\n\",\n    \"src/components/InfiniteScroll.jsx\": \"import React, { useState, useEffect, useRef, useCallback } from 'react';\\nimport '../assets/styles/global.css';\\n\\nconst InfiniteScroll = ({\\n  children,\\n  onLoadMore,\\n  hasMore,\\n  isLoading = false, // Prop to indicate if data is currently being fetched\\n}) => {\\n  const observer = useRef(null);\\n  const sentinelRef = useRef(null);\\n\\n  const initializeObserver = useCallback( () => {\\n    if (sentinelRef.current) {\\n      observer.current = new IntersectionObserver(\\n        (entries) => {\\n          entries.forEach((entry) => {\\n            // When the sentinel element (bottom of the list) becomes visible\\n            if (entry.isIntersecting && hasMore && !isLoading) {\\n              onLoadMore();\\n            }\\n          });\\n        },\\n        {\\n          root: null, // Use the viewport as the root\\n          rootMargin: '0px', // No margin\\n          threshold: 0.1, // Trigger when 10% of the sentinel is visible\\n        }\\n      );\\n      observer.current.observe(sentinelRef.current);\\n    }\\n  }, [onLoadMore, hasMore, isLoading]);\\n\\n  useEffect(() => {\\n    initializeObserver();\\n\\n    // Cleanup the observer when the component unmounts or dependencies change\\n    return () => {\\n      if (observer.current && sentinelRef.current) {\\n        observer.current.unobserve(sentinelRef.current);\\n      }\\n    };\\n  }, [initializeObserver]); // Re-initialize if dependencies change\\n\\n  return (\\n    <div className=\\\"w-full\\\">\\n      {children} {/* Render the actual content (e.g., AnimeGrid) */}\\n      {hasMore && (\\n        <div ref={sentinelRef} className=\\\"h-10 w-full flex items-center justify-center\\\">\\n          {isLoading && <p className=\\\"text-primary dark:text-white\\\">Loading more...</p>}\\n        </div>\\n      )}\\n      {!hasMore && !isLoading && (\\n        <div className=\\\"text-center py-6 text-secondary dark:text-gray-400\\\">\\n          <p>You've reached the end.</p>\\n        </div>\\n      )}\\n    </div>\\n  );\\n};\\n\\nexport default InfiniteScroll;\\n\",\n    \"src/components/SkeletonLoader/SkeletonLoader.jsx\": \"import React from 'react';\\nimport ShimmerEffect from './ShimmerEffect.jsx';\\nimport '../assets/styles/global.css';\\n\\nconst SkeletonLoader = ({\\n  className,\\n  children,\\n  ...props\\n}) => {\\n  return (\\n    <div\\n      className={`relative w-full h-full rounded-lg overflow-hidden bg-secondary dark:bg-secondary-dark ${className}`}\\n      {...props}\\n    >\\n      {children || (\\n        <div className=\\\"absolute inset-0\\\">\\n          <ShimmerEffect />\\n        </div>\\n      )}\\n      {!children && <ShimmerEffect />}\\n    </div>\\n  );\\n};\\n\\nexport default SkeletonLoader;\\n\",\n    \"src/components/SkeletonLoader/ShimmerEffect.jsx\": \"import React from 'react';\\nimport '../assets/styles/global.css';\\n\\nconst ShimmerEffect = () => {\\n  return (\\n    <div className=\\\"absolute inset-0 overflow-hidden pointer-events-none\\\">\\n      <div className=\\\"absolute inset-0 animate-shimmer bg-gradient-to-br from-transparent via-white/20 to-transparent\\\"></div>\\n    </div>\\n  );\\n};\\n\\nexport default ShimmerEffect;\\n\",\n    \"src/components/VideoPlayer.jsx\": \"import React, { useRef, useState, useEffect } from 'react';\\nimport '../assets/styles/global.css';\\n\\nconst VideoPlayer = ({ videoUrl }) => {\\n  const videoRef = useRef(null);\\n  const [isPlaying, setIsPlaying] = useState(false);\\n  const [volume, setVolume] = useState(1);\\n  const [isHovering, setIsHovering] = useState(false);\\n\\n  // Autoplay on hover for desktop\\n  useEffect(() => {\\n    if (videoRef.current) {\\n      if (isHovering && !isPlaying) {\\n        // Check if it's a desktop device to avoid autoplay on mobile\\n        const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);\\n        if (!isMobile) {\\n          videoRef.current.play().then(() => setIsPlaying(true)).catch(error => console.error('Autoplay failed:', error));\\n        }\\n      } else if (!isHovering && isPlaying) {\\n        videoRef.current.pause();\\n        setIsPlaying(false);\\n      }\\n    }\\n  }, [isHovering, isPlaying]);\\n\\n  // Mute/Unmute and Volume control\\n  const togglePlayPause = () => {\\n    if (videoRef.current) {\\n      if (isPlaying) {\\n        videoRef.current.pause();\\n      } else {\\n        videoRef.current.play();\\n      }\\n      setIsPlaying(!isPlaying);\\n    }\\n  };\\n\\n  const handleVolumeChange = (e) => {\\n    const newVolume = parseFloat(e.target.value);\\n    setVolume(newVolume);\\n    if (videoRef.current) {\\n      videoRef.current.volume = newVolume;\\n    }\\n  };\\n\\n  const toggleMute = () => {\\n    if (videoRef.current) {\\n      videoRef.current.muted = !videoRef.current.muted;\\n      // Update volume state to reflect mute status if needed, though muted property is primary\\n      if (videoRef.current.muted) {\\n        setVolume(0);\\n      } else {\\n        setVolume(videoRef.current.volume);\\n      }\\n    }\\n  };\\n\\n  const handleTimeUpdate = () => {\\n    // Update isPlaying state based on video playback, useful for initial autoplay state\\n    if (videoRef.current && !isHovering) { // Only update if not actively controlled by hover\\n      setIsPlaying(!videoRef.current.paused);\\n    }\\n  };\\n\\n  const handleVideoEnded = () => {\\n    setIsPlaying(false);\\n    // Optionally loop or reset player here\\n    if (videoRef.current) {\\n      videoRef.current.currentTime = 0;\\n    }\\n  };\\n\\n  if (!videoUrl) {\\n    return <div className=\\\"w-full h-64 bg-gray-800 flex items-center justify-center text-white\\\">No trailer available.</div>;\\n  }\\n\\n  return (\\n    <div\\n      className=\\\"relative w-full h-64 md:h-96 overflow-hidden rounded-lg shadow-xl bg-black\\\"\\n      onMouseEnter={() => setIsHovering(true)}\\n      onMouseLeave={() => setIsHovering(false)}\\n    >\\n      <video\\n        ref={videoRef}\\n        src={videoUrl}\\n        className=\\\"w-full h-full object-contain\\\"\\n        loop\\n        muted // Start muted for autoplay policies\\n        playsInline // For better mobile experience\\n        onTimeUpdate={handleTimeUpdate}\\n        onEnded={handleVideoEnded}\\n      ></video>\\n\\n      {/* Controls Overlay */}\\n      <div className=\\\"absolute inset-0 flex flex-col justify-end p-4 bg-gradient-to-t from-black/70 to-transparent transition-opacity duration-500\\\"\\n        style={{ opacity: isHovering || isPlaying ? 1 : 0 }}>\\n        <div className=\\\"flex items-center justify-between space-x-4\\\">\\n          <button onClick={togglePlayPause} className=\\\"text-white hover:text-accent focus:outline-none\\\">\\n            <span className=\\\"material-icons text-4xl\\\">\\n              {isPlaying ? 'pause_circle_filled' : 'play_circle_filled'}\\n            </span>\\n          </button>\\n          <div className=\\\"flex items-center space-x-2\\\">\\n            <button onClick={toggleMute} className=\\\"text-white hover:text-accent focus:outline-none\\\">\\n              <span className=\\\"material-icons text-2xl\\\">\\n                {volume === 0 ? 'volume_off' : 'volume_up'}\\n              </span>\\n            </button>\\n            <input\\n              type=\\\"range\\\"\\n              min=\\\"0\\\"\\n              max=\\\"1\\\"\\n              step=\\\"0.01\\\"\\n              value={volume}\\n              onChange={handleVolumeChange}\\n              className=\\\"w-24 h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer accent-accent\\\"\\n            />\\n          </div>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\\nexport default VideoPlayer;\\n\",\n    \"src/components/HeroSection.jsx\": \"import React, { useEffect, useState } from 'react';\\nimport '../assets/styles/global.css';\\n\\n// Placeholder for parallax effect if needed, using GSAP or CSS animations\\n// import gsap from 'gsap';\\n// import { ScrollTrigger } from 'gsap/ScrollTrigger';\\n// gsap.registerPlugin(ScrollTrigger);\\n\\nconst HeroSection = ({ \\n  imageUrl = 'https://via.placeholder.com/1920x1080?text=Featured+Anime',\\n  title = 'Your Next Favorite Anime', \\n  description = 'Discover a world of anime and manga. Dive into epic stories, memorable characters, and breathtaking animation.',\\n  ctaText = 'Explore Anime',\\n  ctaLink = '/browse'\\n}) => {\\n  const [isClient, setIsClient] = useState(false);\\n\\n  useEffect(() => {\\n    setIsClient(true);\\n    // Example of how to integrate GSAP parallax for desktop: \\n    // This requires GSAP to be installed (`npm install gsap`)\\n    /*\\n    if (window.innerWidth > 1024) { // Apply parallax only on larger screens\\n      gsap.fromTo(\\n        '#hero-background',\\n        { y: -50 },\\n        { y: 50, ease: 'none', scrollTrigger: { trigger: '#hero-section', start: 'top top', end: 'bottom top', scrub: 1 } }\\n      );\\n      gsap.fromTo(\\n        '#hero-content',\\n        { y: 50, opacity: 0 },\\n        { y: 0, opacity: 1, ease: 'power2.out', duration: 1, delay: 0.5 }\\n      );\\n    } else {\\n      // For mobile, ensure no parallax effects interfere and content is visible\\n      gsap.set('#hero-background', { y: 0 });\\n      gsap.set('#hero-content', { y: 0, opacity: 1 });\\n    }\\n    */\\n  }, []);\\n\\n  return (\\n    <section\\n      id=\\\"hero-section\\\"\\n      className=\\\"relative w-full h-screen lg:h-[80vh] flex items-center justify-center t