        "jsCode": "return [\n  {\n    \"cleaned_folder_json\": {\n      \"README.md\": \"# My React E-commerce App\\n\\nThis project is a boilerplate for a modern React e-commerce application, built with Vite and designed with a clear, scalable folder structure.\\n\\n## Getting Started\\n\\n1.  **Install dependencies:**\\n    `npm install`\\n2.  **Run the development server:**\\n    `npm run dev`\\n3.  **Build for production:**\\n    `npm run build`\\n\\n## Project Structure\\n\\n-   `public/`: Static assets.\\n-   `src/`:\\n    -   `assets/`: Images, icons, etc.\\n    -   `components/`: Reusable UI components.\\n    -   `pages/`: Top-level components representing distinct views/pages.\\n    -   `hooks/`: Custom React hooks for reusable logic.\\n    -   `context/`: React Context providers for global state management.\\n    -   `styles/`: Global styles, variables, and utility classes.\\n    -   `utils/`: Utility functions (API, auth, helpers).\\n\\n## Features (Planned/Boilerplate)\\n\\n-   User Authentication (Login, Register, Profile)\\n-   Product Listing and Detail Views\\n-   Shopping Cart functionality\\n-   Checkout Process\\n-   Order History\\n-   Global state management with React Context\\n-   Routing with React Router DOM\\n\\nFeel free to customize and expand upon this foundation!\",\n      \".gitignore\": \"# Logs\\nlogs\\n*.log\\nnpm-debug.log*\\nyarn-debug.log*\\nyarn-error.log*\\n\\n# Dependency directories\\nnode_modules/\\njspm_packages/\\n\\n# Optional npm cache directory\\n.npm/\\n\\n# Optional eslint cache\\n.eslintcache\\n\\n# Optional Storybook output\\n.storybook-out\\n\\n# Production\\nbuild/\\ndist/\\n\\n# Miscellaneous\\n.DS_Store\\n.env\\n.env.local\\n.env.*.local\\n\\n# IDEs and editors\\n.idea/\\n.vscode/\\n*.iml\\n*.suo\\n*.ntvs*\\n*.njsproj\\n*.sln\\n*.sw?\\n\\n# Vite-specific\\n.vite/\\n\",\n      \"package.json\": {\n        \"name\": \"react-ecommerce-app\",\n        \"private\": true,\n        \"version\": \"0.0.0\",\n        \"type\": \"module\",\n        \"scripts\": {\n          \"dev\": \"vite\",\n          \"build\": \"vite build\",\n          \"lint\": \"eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0\",\n          \"preview\": \"vite preview\",\n          \"test\": \"jest\",\n          \"format\": \"prettier --write \\\"src/**/*.{js,jsx,json,css,md}\\\"\"\n        },\n        \"dependencies\": {\n          \"react\": \"^18.2.0\",\n          \"react-dom\": \"^18.2.0\",\n          \"react-router-dom\": \"^6.22.3\",\n          \"axios\": \"^1.6.8\"\n        },\n        \"devDependencies\": {\n          \"@types/react\": \"^18.2.66\",\n          \"@types/react-dom\": \"^18.2.22\",\n          \"@vitejs/plugin-react\": \"^4.2.1\",\n          \"eslint\": \"^8.57.0\",\n          \"eslint-plugin-react\": \"^7.34.1\",\n          \"eslint-plugin-react-hooks\": \"^4.6.0\",\n          \"eslint-plugin-react-refresh\": \"^0.4.6\",\n          \"vite\": \"^5.2.0\",\n          \"jest\": \"^29.7.0\",\n          \"@testing-library/react\": \"^14.2.2\",\n          \"@testing-library/jest-dom\": \"^6.4.2\",\n          \"jest-environment-jsdom\": \"^29.7.0\",\n          \"prettier\": \"^3.2.5\",\n          \"eslint-config-prettier\": \"^9.1.0\",\n          \"eslint-plugin-prettier\": \"^5.1.3\",\n          \"babel-jest\": \"^29.7.0\",\n          \"@babel/preset-env\": \"^7.24.3\",\n          \"@babel/preset-react\": \"^7.23.3\",\n          \"identity-obj-proxy\": \"^3.0.0\"\n        }\n      },\n      \"public\": {\n        \"index.html\": \"<!doctype html>\\n<html lang=\\\"en\\\">\\n  <head>\\n    <meta charset=\\\"UTF-8\\\" />\\n    <link rel=\\\"icon\\\" type=\\\"image/svg+xml\\\" href=\\\"/favicon.ico\\\" />\\n    <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\" />\\n    <title>React E-commerce App</title>\\n  </head>\\n  <body>\\n    <div id=\\\"root\\\"></div>\\n    <script type=\\\"module\\\" src=\\\"/src/main.jsx\\\"></script>\\n  </body>\\n</html>\\n\",\n        \"favicon.ico\": \"\"\n      },\n      \"src\": {\n        \"main.jsx\": \"import React from 'react';\\nimport ReactDOM from 'react-dom/client';\\nimport App from './App.jsx';\\nimport './styles/index.css';\\n\\nReactDOM.createRoot(document.getElementById('root')).render(\\n  <React.StrictMode>\\n    <App />\\n  </React.StrictMode>,\\n);\\n\",\n        \"App.jsx\": \"import React from 'react';\\nimport { BrowserRouter, Routes, Route } from 'react-router-dom';\\nimport { AuthProvider } from './context/AuthContext';\\nimport { CartProvider } from './context/CartContext';\\n\\nimport Layout from './pages/Layout';\\nimport Home from './pages/Home';\\nimport Shop from './pages/Shop';\\nimport ProductDetail from './pages/ProductDetail';\\nimport Cart from './pages/Cart';\\nimport Login from './pages/Login';\\nimport Register from './pages/Register';\\nimport Profile from './pages/Profile';\\nimport Checkout from './pages/Checkout';\\nimport OrderHistory from './pages/OrderHistory';\\nimport OrderDetail from './pages/OrderDetail';\\nimport NotFound from './pages/NotFound';\\nimport SearchPage from './pages/SearchPage';\\n\\nfunction App() {\\n  return (\\n    <BrowserRouter>\\n      <AuthProvider>\\n        <CartProvider>\\n          <Routes>\\n            <Route path=\\\"/\\\" element={<Layout />}>\\n              <Route index element={<Home />} />\\n              <Route path=\\\"shop\\\" element={<Shop />} />\\n              <Route path=\\\"product/:id\\\" element={<ProductDetail />} />\\n              <Route path=\\\"search\\\" element={<SearchPage />} />\\n              <Route path=\\\"cart\\\" element={<Cart />} />\\n              <Route path=\\\"login\\\" element={<Login />} />\\n              <Route path=\\\"register\\\" element={<Register />} />\\n              <Route path=\\\"profile\\\" element={<Profile />} />\\n              <Route path=\\\"checkout\\\" element={<Checkout />} />\\n              <Route path=\\\"orders\\\" element={<OrderHistory />} />\\n              <Route path=\\\"orders/:id\\\" element={<OrderDetail />} />\\n              <Route path=\\\"*\\\" element={<NotFound />} />\\n            </Route>\\n          </Routes>\\n        </CartProvider>\\n      </AuthProvider>\\n    </BrowserRouter>\\n  );\\n}\\n\\nexport default App;\\n\",\n        \"assets\": {},\n        \"components\": {\n          \"Header.jsx\": \"import React from 'react';\\nimport { Link, NavLink } from 'react-router-dom';\\nimport { useAuth } from '../hooks/useAuth';\\nimport { useCart } from '../hooks/useCart';\\n\\nfunction Header() {\\n  const { user, logout } = useAuth();\\n  const { cartItems } = useCart();\\n  const totalItems = cartItems.reduce((acc, item) => acc + item.quantity, 0);\\n\\n  return (\\n    <header className=\\\"header\\\">\\n      <div className=\\\"container\\\">\\n        <Link to=\\\"/\\\" className=\\\"logo\\\">E-Shop</Link>\\n        <nav className=\\\"main-nav\\\">\\n          <ul>\\n            <li><NavLink to=\\\"/\\\" className={({ isActive }) => isActive ? 'active' : ''}>Home</NavLink></li>\\n            <li><NavLink to=\\\"/shop\\\" className={({ isActive }) => isActive ? 'active' : ''}>Shop</NavLink></li>\\n            <li><NavLink to=\\\"/search\\\" className={({ isActive }) => isActive ? 'active' : ''}>Search</NavLink></li>\\n            <li>\\n              <NavLink to=\\\"/cart\\\" className={({ isActive }) => isActive ? 'active' : ''}>\\n                Cart {totalItems > 0 && <span>({totalItems})</span>}\\n              </NavLink>\\n            </li>\\n            {user ? (\\n              <>\\n                <li><NavLink to=\\\"/profile\\\" className={({ isActive }) => isActive ? 'active' : ''}>Profile ({user.firstName || user.email})</NavLink></li>\\n                <li><button onClick={logout} className=\\\"logout-button\\\">Logout</button></li>\\n              </>\\n            ) : (\\n              <li><NavLink to=\\\"/login\\\" className={({ isActive }) => isActive ? 'active' : ''}>Login</NavLink></li>\\n            )}\\n          </ul>\\n        </nav>\\n      </div>\\n    </header>\\n  );\\n}\\n\\nexport default Header;\\n\",\n          \"Footer.jsx\": \"import React from 'react';\\n\\nfunction Footer() {\\n  return (\\n    <footer className=\\\"footer\\\">\\n      <div className=\\\"container\\\">\\n        <p>&copy; {new Date().getFullYear()} E-Shop. All rights reserved.</p>\\n      </div>\\n    </footer>\\n  );\\n}\\n\\nexport default Footer;\\n\",\n          \"ProductCard.jsx\": \"import React from 'react';\\nimport { Link } from 'react-router-dom';\\nimport { useCart } from '../hooks/useCart';\\n\\nfunction ProductCard({ product }) {\\n  const { addToCart } = useCart();\\n\\n  const handleAddToCart = async () => {\\n    await addToCart(product.id, 1, product);\\n  };\\n\\n  return (\\n    <div className=\\\"product-card\\\">\\n      <Link to={`/product/${product.id}`}>\\n        <img src={product.imageUrl} alt={product.name} className=\\\"product-image\\\" />\\n        <h3 className=\\\"product-name\\\">{product.name}</h3>\\n      </Link>\\n      <p className=\\\"product-price\\\">${product.price?.toFixed(2)}</p>\\n      <button onClick={handleAddToCart} className=\\\"add-to-cart-button\\\">Add to Cart</button>\\n    </div>\\n  );\\n}\\n\\nexport default ProductCard;\\n\",\n          \"CategoryNav.jsx\": \"import React from 'react';\\nimport { NavLink } from 'react-router-dom';\\nimport { useCategories } from '../hooks/useCategories';\\nimport LoadingSpinner from './LoadingSpinner';\\nimport ErrorMessage from './ErrorMessage';\\n\\nfunction CategoryNav() {\\n  const { categories, loading, error } = useCategories();\\n\\n  if (loading) return <LoadingSpinner />;\\n  if (error) return <ErrorMessage message={error} />;\\n\\n  return (\\n    <nav className=\\\"category-nav\\\">\\n      <ul>\\n        <li><NavLink to=\\\"/shop\\\" end className={({ isActive }) => isActive ? 'active' : ''}>All Products</NavLink></li>\\n        {categories.map(category => (\\n          <li key={category.id}>\\n            <NavLink \\n              to={`/shop?category=${category.name}`}\\n              className={({ isActive }) => isActive ? 'active' : ''}\\n            >\\n              {category.name}\\n            </NavLink>\\n          </li>\\n        ))}\\n      </ul>\\n    </nav>\\n  );\\n}\\n\\nexport default CategoryNav;\\n\",\n          \"CartItem.jsx\": \"import React from 'react';\\nimport { useCart } from '../hooks/useCart';\\n\\nfunction CartItem({ item }) {\\n  const { updateQuantity, removeFromCart } = useCart();\\n\\n  const handleUpdateQuantity = async (newQuantity) => {\\n    if (newQuantity < 1) {\\n      await removeFromCart(item.productId); // Remove if quantity goes to 0 or less\\n    } else {\\n      await updateQuantity(item.productId, newQuantity);\\n    }\\n  };\\n\\n  const handleRemove = async () => {\\n    await removeFromCart(item.productId);\\n  };\\n\\n  return (\\n    <div className=\\\"cart-item\\\">\\n      <img src={item.imageUrl} alt={item.name} className=\\\"cart-item-image\\\" />\\n      <div className=\\\"cart-item-details\\\">\\n        <h4>{item.name}</h4>\\n        <p>${item.price?.toFixed(2)}</p>\\n        <div className=\\\"cart-item-quantity-controls\\\">\\n          <button onClick={() => handleUpdateQuantity(item.quantity - 1)}>-</button>\\n          <span>{item.quantity}</span>\\n          <button onClick={() => handleUpdateQuantity(item.quantity + 1)}>+</button>\\n        </div>\\n        <button onClick={handleRemove} className=\\\"remove-button\\\">Remove</button>\\n      </div>\\n    </div>\\n  );\\n}\\n\\nexport default CartItem;\\n\",\n          \"AuthForm.jsx\": \"import React, { useState } from 'react';\\nimport { useAuth } from '../hooks/useAuth';\\n\\nfunction AuthForm({ type }) {\\n  const [email, setEmail] = useState('');\\n  const [password, setPassword] = useState('');\\n  const { login, register, error, loading } = useAuth();\\n\\n  const handleSubmit = async (e) => {\\n    e.preventDefault();\\n    if (type === 'login') {\\n      await login(email, password);\\n    } else {\\n      // For registration, API specifies optional firstName, lastName\\n      // For simplicity, we'll only send email and password here\\n      await register(email, password);\\n    }\\n  };\\n\\n  return (\\n    <form onSubmit={handleSubmit} className=\\\"auth-form\\\">\\n      <h2>{type === 'login' ? 'Login' : 'Register'}</h2>\\n      {error && <p className=\\\"error-message\\\">{error}</p>}\\n      <div className=\\\"form-group\\\">\\n        <label htmlFor=\\\"email\\\">Email:</label>\\n        <input\\n          type=\\\"email\\\"\\n          id=\\\"email\\\"\\n          value={email}\\n          onChange={(e) => setEmail(e.target.value)}\\n          required\\n        />\\n      </div>\\n      <div className=\\\"form-group\\\">\\n        <label htmlFor=\\\"password\\\">Password:</label>\\n        <input\\n          type=\\\"password\\\"\\n          id=\\\"password\\\"\\n          value={password}\\n          onChange={(e) => setPassword(e.target.value)}\\n          required\\n        />\\n      </div>\\n      <button type=\\\"submit\\\" disabled={loading}>\\n        {loading ? 'Loading...' : (type === 'login' ? 'Login' : 'Register')}\\n      </button>\\n    </form>\\n  );\\n}\\n\\nexport default AuthForm;\\n\",\n          \"AddressForm.jsx\": \"import React, { useState, useEffect } from 'react';\\n\\nfunction AddressForm({ onSave, initialAddress = null, submitButtonText = 'Save Address' }) {\\n  const [address, setAddress] = useState({\\n    street: '',\\n    city: '',\\n    state: '',\\n    zipCode: '', // Changed to zipCode as per API\\n    country: '',\\n    isDefault: false,\\n  });\\n\\n  useEffect(() => {\\n    if (initialAddress) {\\n      setAddress({\\n        street: initialAddress.street || '',\\n        city: initialAddress.city || '',\\n        state: initialAddress.state || '',\\n        zipCode: initialAddress.zipCode || '',\\n        country: initialAddress.country || '',\\n        isDefault: initialAddress.isDefault || false,\\n      });\\n    }\\n  }, [initialAddress]);\\n\\n  const handleChange = (e) => {\\n    const { name, value, type, checked } = e.target;\\n    setAddress((prev) => ({\\n      ...prev,\\n      [name]: type === 'checkbox' ? checked : value,\\n    }));\\n  };\\n\\n  const handleSubmit = (e) => {\\n    e.preventDefault();\\n    onSave(address);\\n  };\\n\\n  return (\\n    <form onSubmit={handleSubmit} className=\\\"address-form\\\">\\n      <div className=\\\"form-group\\\">\\n        <label htmlFor=\\\"street\\\">Street:</label>\\n        <input type=\\\"text\\\" id=\\\"street\\\" name=\\\"street\\\" value={address.street} onChange={handleChange} required />\\n      </div>\\n      <div className=\\\"form-group\\\">\\n        <label htmlFor=\\\"city\\\">City:</label>\\n        <input type=\\\"text\\\" id=\\\"city\\\" name=\\\"city\\\" value={address.city} onChange={handleChange} required />\\n      </div>\\n      <div className=\\\"form-group\\\">\\n        <label htmlFor=\\\"state\\\">State/Province:</label>\\n        <input type=\\\"text\\\" id=\\\"state\\\" name=\\\"state\\\" value={address.state} onChange={handleChange} required />\\n      </div>\\n      <div className=\\\"form-group\\\">\\n        <label htmlFor=\\\"zipCode\\\">Zip/Postal Code:</label>\\n        <input type=\\\"text\\\" id=\\\"zipCode\\\" name=\\\"zipCode\\\" value={address.zipCode} onChange={handleChange} required />\\n      </div>\\n      <div className=\\\"form-group\\\">\\n        <label htmlFor=\\\"country\\\">Country:</label>\\n        <input type=\\\"text\\\" id=\\\"country\\\" name=\\\"country\\\" value={address.country} onChange={handleChange} required />\\n      </div>\\n      <div className=\\\"form-group checkbox-group\\\">\\n        <label>\\n          <input\\n            type=\\\"checkbox\\\"\\n            name=\\\"isDefault\\\"\\n            checked={address.isDefault}\\n            onChange={handleChange}\\n          />\\n          Set as default address\\n        </label>\\n      </div>\\n      <button type=\\\"submit\\\" className=\\\"button primary-button\\\">{submitButtonText}</button>\\n    </form>\\n  );\\n}\\n\\nexport default AddressForm;\\n\",\n          \"PaymentForm.jsx\": \"import React, { useState } from 'react';\\n\\nfunction PaymentForm({ onSave }) {\\n  const [paymentMethodType, setPaymentMethodType] = useState('card'); // Changed to 'card' as per API\\n  const [cardDetails, setCardDetails] = useState({\\n    cardNumber: '',\\n    expiry: '',\\n    cvc: '',\\n  });\\n\\n  const handleMethodChange = (e) => {\\n    setPaymentMethodType(e.target.value);\\n  };\\n\\n  const handleCardDetailChange = (e) => {\\n    const { name, value } = e.target;\\n    setCardDetails((prev) => ({ ...prev, [name]: value }));\\n  };\\n\\n  const handleSubmit = (e) => {\\n    e.preventDefault();\\n    const paymentData = {\\n      paymentMethodType,\\n      paymentDetails: paymentMethodType === 'card' ? cardDetails : { /* paypal specific details if needed */ },\\n    };\\n    onSave(paymentData);\\n  };\\n\\n  return (\\n    <form onSubmit={handleSubmit} className=\\\"payment-form\\\">\\n      <h3>Payment Method</h3>\\n      <div className=\\\"form-group\\\">\\n        <label>\\n          <input\\n            type=\\\"radio\\\"\\n            name=\\\"paymentMethodType\\\"\\n            value=\\\"card\\\"\\n            checked={paymentMethodType === 'card'}\\n            onChange={handleMethodChange}\\n          />\\n          Credit Card\\n        </label>\\n      </div>\\n      <div className=\\\"form-group\\\">\\n        <label>\\n          <input\\n            type=\\\"radio\\\"\\n            name=\\\"paymentMethodType\\\"\\n            value=\\\"paypal\\\"\\n            checked={paymentMethodType === 'paypal'}\\n            onChange={handleMethodChange}\\n          />\\n          PayPal\\n        </label>\\n      </div>\\n      \\n      {paymentMethodType === 'card' && (\\n        <div className=\\\"credit-card-details\\\">\\n          <div className=\\\"form-group\\\">\\n            <label htmlFor=\\\"cardNumber\\\">Card Number:</label>\\n            <input type=\\\"text\\\" id=\\\"cardNumber\\\" name=\\\"cardNumber\\\" value={cardDetails.cardNumber} onChange={handleCardDetailChange} placeholder=\\\"XXXX XXXX XXXX XXXX\\\" required />\\n          </div>\\n          <div className=\\\"form-group\\\">\\n            <label htmlFor=\\\"expiry\\\">Expiry Date:</label>\\n            <input type=\\\"text\\\" id=\\\"expiry\\\" name=\\\"expiry\\\" value={cardDetails.expiry} onChange={handleCardDetailChange} placeholder=\\\"MM/YY\\\" required />\\n          </div>\\n          <div className=\\\"form-group\\\">\\n            <label htmlFor=\\\"cvc\\\">CVV:</label>\\n            <input type=\\\"text\\\" id=\\\"cvc\\\" name=\\\"cvc\\\" value={cardDetails.cvc} onChange={handleCardDetailChange} placeholder=\\\"123\\\" required />\\n          </div>\\n        </div>\\n      )}\\n      <button type=\\\"submit\\\" className=\\\"button primary-button\\\">Continue to Review</button>\\n    </form>\\n  );\\n}\\n\\nexport default PaymentForm;\\n\",\n          \"LoadingSpinner.jsx\": \"import React from 'react';\\n\\nfunction LoadingSpinner() {\\n  return (\\n    <div className=\\\"loading-spinner\\\">\\n      <div className=\\\"spinner\\\"></div>\\n      <p>Loading...</p>\\n    </div>\\n  );\\n}\\n\\nexport default LoadingSpinner;\\n\",\n          \"ErrorMessage.jsx\": \"import React from 'react';\\n\\nfunction ErrorMessage({ message }) {\\n  if (!message) return null;\\n  return (\\n    <div className=\\\"error-message\\\">\\n      <p>{message}</p>\\n    </div>\\n  );\\n}\\n\\nexport default ErrorMessage;\\n\",\n          \"ProfileEditForm.jsx\": \"import React, { useState, useEffect } from 'react';\\nimport { useAuth } from '../hooks/useAuth';\\nimport { api } from '../utils/api';\\nimport ErrorMessage from './ErrorMessage';\\nimport LoadingSpinner from './LoadingSpinner';\\n\\nfunction ProfileEditForm({ onSaveSuccess }) {\\n  const { user, setUser } = useAuth();\\n  const [formData, setFormData] = useState({\\n    firstName: '',\\n    lastName: '',\\n    email: '',\\n  });\\n  const [loading, setLoading] = useState(false);\\n  const [error, setError] = useState(null);\\n  const [success, setSuccess] = useState(false);\\n\\n  useEffect(() => {\\n    if (user) {\\n      setFormData({\\n        firstName: user.firstName || '',\\n        lastName: user.lastName || '',\\n        email: user.email || '',\\n      });\\n    }\\n  }, [user]);\\n\\n  const handleChange = (e) => {\\n    const { name, value } = e.target;\\n    setFormData((prev) => ({ ...prev, [name]: value }));\\n  };\\n\\n  const handleSubmit = async (e) => {\\n    e.preventDefault();\\n    setLoading(true);\\n    setError(null);\\n    setSuccess(false);\\n\\n    try {\\n      const response = await api.put('/v1/profile', formData);\\n      setUser(response.data.user); // Update user in AuthContext with new profile data\\n      setSuccess(true);\\n      if (onSaveSuccess) {\\n        onSaveSuccess();\\n      }\\n    } catch (err) {\\n      setError(err.response?.data?.message || 'Failed to update profile.');\\n      console.error('Profile update error:', err);\\n    } finally {\\n      setLoading(false);\\n    }\\n  };\\n\\n  if (loading) return <LoadingSpinner />;\\n\\n  return (\\n    <form onSubmit={handleSubmit} className=\\\"profile-edit-form\\\">\\n      <h3>Edit Profile Information</h3>\\n      {error && <ErrorMessage message={error} />}\\n      {success && <p className=\\\"success-message\\\">Profile updated successfully!</p>}\\n      <div className=\\\"form-group\\\">\\n        <label htmlFor=\\\"firstName\\\">First Name:</label>\\n        <input type=\\\"text\\\" id=\\\"firstName\\\" name=\\\"firstName\\\" value={formData.firstName} onChange={handleChange} />\\n      </div>\\n      <div className=\\\"form-group\\\">\\n        <label htmlFor=\\\"lastName\\\">Last Name:</label>\\n        <input type=\\\"text\\\" id=\\\"lastName\\\" name=\\\"lastName\\\" value={formData.lastName} onChange={handleChange} />\\n      </div>\\n      <div className=\\\"form-group\\\">\\n        <label htmlFor=\\\"email\\\">Email:</label>\\n        <input type=\\\"email\\\" id=\\\"email\\\" name=\\\"email\\\" value={formData.email} onChange={handleChange} required />\\n      </div>\\n      <button type=\\\"submit\\\" className=\\\"button primary-button\\\" disabled={loading}>Update Profile</button>\\n    </form>\\n  );\\n}\\n\\nexport default ProfileEditForm;\\n\",\n          \"ProfileAddressManager.jsx\": \"import React, { useState, useEffect } from 'react';\\nimport { useAuth } from '../hooks/useAuth';\\nimport { api } from '../utils/api';\\nimport AddressForm from './AddressForm';\\nimport LoadingSpinner from './LoadingSpinner';\\nimport ErrorMessage from './ErrorMessage';\\n\\nfunction ProfileAddressManager() {\\n  const { user, setUser } = useAuth();\\n  const [addresses, setAddresses] = useState([]);\\n  const [loading, setLoading] = useState(true);\\n  const [error, setError] = useState(null);\\n  const [editingAddressId, setEditingAddressId] = useState(null);\\n\\n  const fetchAddresses = async () => {\\n    if (!user) return;\\n    setLoading(true);\\n    setError(null);\\n    try {\\n      const response = await api.get('/v1/profile'); // Fetch full profile including addresses\\n      setAddresses(response.data.addresses || []);\\n      setUser(response.data); // Update user context with latest profile data\\n    } catch (err) {\\n      setError(err.response?.data?.message || 'Failed to fetch addresses.');\\n      console.error('Fetch addresses error:', err);\\n    } finally {\\n      setLoading(false);\\n    }\\n  };\\n\\n  useEffect(() => {\\n    fetchAddresses();\\n  }, [user?.userId]); // Re-fetch if user changes\\n\\n  const handleSaveAddress = async (addressData) => {\\n    setLoading(true);\\n    setError(null);\\n    try {\\n      if (editingAddressId) {\\n        await api.put(`/v1/profile/addresses/${editingAddressId}`, addressData);\\n      } else {\\n        await api.post('/v1/profile/addresses', addressData);\\n      }\\n      setEditingAddressId(null); // Exit edit mode\\n      await fetchAddresses(); // Refresh addresses\\n    } catch (err) {\\n      setError(err.response?.data?.message || 'Failed to save address.');\\n      console.error('Save address error:', err);\\n    } finally {\\n      setLoading(false);\\n    }\\n  };\\n\\n  const handleDeleteAddress = async (addressId) => {\\n    if (!window.confirm('Are you sure you want to delete this address?')) return;\\n    setLoading(true);\\n    setError(null);\\n    try {\\n      await api.delete(`/v1/profile/addresses/${addressId}`);\\n      await fetchAddresses(); // Refresh addresses\\n    } catch (err) {\\n      setError(err.response?.data?.message || 'Failed to delete address.');\\n      console.error('Delete address error:', err);\\n    } finally {\\n      setLoading(false);\\n    }\\n  };\\n\\n  if (loading) return <LoadingSpinner />;\\n  if (error) return <ErrorMessage message={error} />;\\n\\n  const addressToEdit = editingAddressId ? addresses.find(addr => addr.id === editingAddressId) : null;\\n\\n  return (\\n    <div className=\\\"profile-address-manager\\\">\\n      <h3>Your Addresses</h3>\\n      {addresses.length === 0 && <p>No addresses added yet.</p>}\\n      <div className=\\\"address-list\\\">\\n        {addresses.map((addr) => (\\n          <div key={addr.id} className={`address-item ${addr.isDefault ? 'default-address' : ''}`}>\\n            <p>{addr.street}</p>\\n            <p>{addr.city}, {addr.state} {addr.zipCode}</p>\\n            <p>{addr.country}</p>\\n            {addr.isDefault && <span className=\\\"default-badge\\\">Default</span>}\\n            <div className=\\\"address-actions\\\">\\n              <button onClick={() => setEditingAddressId(addr.id)} className=\\\"button secondary-button\\\">Edit</button>\\n              <button onClick={() => handleDeleteAddress(addr.id)} className=\\\"button remove-button\\\">Delete</button>\\n            </div>\\n          </div>\\n        ))}\\n      </div>\\n\\n      <h4>{editingAddressId ? 'Edit Address' : 'Add New Address'}</h4>\\n      <AddressForm \\n        onSave={handleSaveAddress} \\n        initialAddress={addressToEdit}\\n        submitButtonText={editingAddressId ? 'Update Address' : 'Add Address'}\\n      />\\n    </div>\\n  );\\n}\\n\\nexport default ProfileAddressManager;\\n\"\n        },\n        \"pages\": {\n          \"Layout.jsx\": \"import React from 'react';\\nimport { Outlet } from 'react-router-dom';\\nimport Header from '../components/Header';\\nimport Footer from '../components/Footer';\\n\\nfunction Layout() {\\n  return (\\n    <div className=\\\"app-container\\\">\\n      <Header />\\n      <main className=\\\"main-content\\\">\\n        <div className=\\\"container\\\">\\n          <Outlet /> {/* Renders child routes */}\\n        </div>\\n      </main>\\n      <Footer />\\n    </div>\\n  );\\n}\\n\\nexport default Layout;\\n\",\n          \"Home.jsx\": \"import React from 'react';\\nimport { Link } from 'react-router-dom';\\n\\nfunction Home() {\\n  return (\\n    <section className=\\\"home-page\\\">\\n      <h1>Welcome to E-Shop!</h1>\\n      <p>Your one-stop destination for all your shopping needs.</p>\\n      <p>Discover amazing products and deals.</p>\\n      <Link to=\\\"/shop\\\" className=\\\"button primary-button\\\">Start Shopping</Link>\\n    </section>\\n  );\\n}\\n\\nexport default Home;\\n\",\n          \"Shop.jsx\": \"import React from 'react';\\nimport ProductCard from '../components/ProductCard';\\nimport CategoryNav from '../components/CategoryNav';\\nimport LoadingSpinner from '../components/LoadingSpinner';\\nimport ErrorMessage from '../components/ErrorMessage';\\nimport { useProducts } from '../hooks/useProducts';\\nimport { useSearchParams } from 'react-router-dom';\\n\\nfunction Shop() {\\n  const [searchParams] = useSearchParams();\\n  const category = searchParams.get('category');\\n\\n  const { products, loading, error } = useProducts(category);\\n\\n  if (loading) return <LoadingSpinner />;\\n  if (error) return <ErrorMessage message={error} />;\\n\\n  return (\\n    <section className=\\\"shop-page\\\">\\n      <h2>{category ? category : 'Our'} Products</h2>\\n      <CategoryNav />\\n      <div className=\\\"product-list\\\">\\n        {products.map(product => (\\n          <ProductCard key={product.id} product={product} />\\n        ))}\\n      </div>\\n    </section>\\n  );\\n}\\n\\nexport default Shop;\\n\",\n          \"ProductDetail.jsx\": \"import React, { useEffect, useState } from 'react';\\nimport { useParams } from 'react-router-dom';\\nimport { useCart } from '../hooks/useCart';\\nimport { api } from '../utils/api';\\nimport LoadingSpinner from '../components/LoadingSpinner';\\nimport ErrorMessage from '../components/ErrorMessage';\\n\\nfunction ProductDetail() {\\n  const { id } = useParams();\\n  const { addToCart } = useCart();\\n  const [product, setProduct] = useState(null);\\n  const [loading, setLoading] = useState(true);\\n  const [error, setError] = useState(null);\\n  const [quantity, setQuantity] = useState(1);\\n\\n  useEffect(() => {\\n    const fetchProduct = async () => {\\n      try {\\n        setLoading(true);\\n        setError(null);\\n        const response = await api.get(`/v1/products/${id}`); \\n        setProduct(response.data);\\n      } catch (err) {\\n        setError(err.response?.data?.message || 'Failed to fetch product details.');\\n        console.error(err);\\n      } finally {\\n        setLoading(false);\\n      }\\n    };\\n    fetchProduct();\\n  }, [id]);\\n\\n  const handleAddToCart = async () => {\\n    if (product) {\\n      await addToCart(product.id, quantity, product); // Pass product for local cart state\\n    }\\n  };\\n\\n  if (loading) return <LoadingSpinner />;\\n  if (error) return <ErrorMessage message={error} />;\\n  if (!product) return <ErrorMessage message=\\\"Product not found.\\\" />;\\n\\n  return (\\n    <section className=\\\"product-detail-page\\\">\\n      <div className=\\\"product-detail-container\\\">\\n        <img src={product.imageUrl} alt={product.name} className=\\\"product-detail-image\\\" />\\n        <div className=\\\"product-detail-info\\\">\\n          <h2>{product.name}</h2>\\n          <p className=\\\"product-detail-price\\\">${product.price?.toFixed(2)}</p>\\n          <p className=\\\"product-detail-description\\\">{product.description || 'A detailed description of the product will be displayed here.'}</p>\\n          <div className=\\\"product-quantity-controls\\\">\\n            <button onClick={() => setQuantity(prev => Math.max(1, prev - 1))}>-</button>\\n            <span>{quantity}</span>\\n            <button onClick={() => setQuantity(prev => prev + 1)}>+</button>\\n          </div>\\n          <button onClick={handleAddToCart} className=\\\"button primary-button\\\">Add to Cart</button>\\n        </div>\\n      </div>\\n    </section>\\n  );\\n}\\n\\nexport default ProductDetail;\\n\",\n          \"SearchPage.jsx\": \"import React, { useState, useEffect } from 'react';\\nimport { useSearchParams } from 'react-router-dom';\\nimport ProductCard from '../components/ProductCard';\\nimport LoadingSpinner from '../components/LoadingSpinner';\\nimport ErrorMessage from '../components/ErrorMessage';\\nimport { api } from '../utils/api';\\nimport { debounce } from '../utils/helpers';\\n\\nfunction SearchPage() {\\n  const [searchParams, setSearchParams] = useSearchParams();\\n  const [searchTerm, setSearchTerm] = useState(searchParams.get('q') || '');\\n  const [searchResults, setSearchResults] = useState([]);\\n  const [loading, setLoading] = useState(false);\\n  const [error, setError] = useState(null);\\n\\n  // Debounced search function\\n  const debouncedPerformSearch = debounce(async (query) => {\\n    if (!query) {\\n      setSearchResults([]);\\n      setLoading(false);\\n      return;\\n    }\\n    setLoading(true);\\n    setError(null);\\n    try {\\n      const response = await api.get(`/v1/products/search?q=${query}`); \\n      setSearchResults(response.data.products);\\n    } catch (err) {\\n      setError(err.response?.data?.message || 'Failed to fetch search results.');\\n      console.error(err);\\n    } finally {\\n      setLoading(false);\\n    }\\n  }, 300);\\n\\n  useEffect(() => {\\n    const query = searchParams.get('q');\\n    if (query) {\\n      setSearchTerm(query);\\n      debouncedPerformSearch(query);\\n    } else {\\n      setSearchResults([]);\\n      setLoading(false);\\n    }\\n  }, [searchParams]); // eslint-disable-line react-hooks/exhaustive-deps\\n\\n  const handleSearchChange = (e) => {\\n    const query = e.target.value;\\n    setSearchTerm(query);\\n    // Update URL params as user types, which will trigger useEffect and debounced search\\n    if (query) {\\n      setSearchParams({ q: query });\\n    } else {\\n      setSearchParams({});\\n    }\\n  };\\n\\n  const handleSearchSubmit = (e) => {\\n    e.preventDefault();\\n    setSearchParams({ q: searchTerm });\\n  };\\n\\n  return (\\n    <section className=\\\"search-page\\\">\\n      <h2>Search Products</h2>\\n      <form onSubmit={handleSearchSubmit} className=\\\"search-form\\\">\\n        <input\\n          type=\\\"text\\\"\\n          placeholder=\\\"Search for products...\\\"\\n          value={searchTerm}\\n          onChange={handleSearchChange}\\n        />\\n        <button type=\\\"submit\\\" className=\\\"button primary-button\\\">Search</button>\\n      </form>\\n\\n      {loading && <LoadingSpinner />}\\n      {error && <ErrorMessage message={error} />}\\n      {!loading && !error && searchResults.length === 0 && searchTerm && (\\n        <p>No products found for \\\"{searchTerm}\\\".</p>\\n      )}\\n      {!loading && !error && searchResults.length === 0 && !searchTerm && (\\n        <p>Enter a search term to find products.</p>\\n      )}\\n      \\n      <div className=\\\"search-results product-list\\\">\\n        {searchResults.map(product => (\\n          <ProductCard key={product.id} product={product} />\\n        ))}\\n      </div>\\n    </section>\\n  );\\n}\\n\\nexport default SearchPage;\\n\",\n          \"Cart.jsx\": \"import React, { useEffect } from 'react';\\nimport { Link } from 'react-router-dom';\\nimport { useCart } from '../hooks/useCart';\\nimport CartItem from '../components/CartItem';\\nimport LoadingSpinner from '../components/LoadingSpinner';\\nimport ErrorMessage from '../components/ErrorMessage';\\n\\nfunction Cart() {\\n  const { cartItems, cartTotal, clearCart, loading, error, fetchCart } = useCart();\\n\\n  useEffect(() => {\\n    fetchCart(); // Fetch cart on component mount\\n  }, []); // eslint-disable-line react-hooks/exhaustive-deps\\n\\n  if (loading) return <LoadingSpinner />;\\n  if (error) return <ErrorMessage message={error} />;\\n\\n  if (cartItems.length === 0) {\\n    return (\\n      <section className=\\\"cart-page\\\">\\n        <h2>Your Cart is Empty</h2>\\n        <p>Looks like you haven't added anything to your cart yet.</p>\\n        <Link to=\\\"/shop\\\" className=\\\"button primary-button\\\">Go to Shop</Link>\\n      </section>\\n    );\\n  }\\n\\n  return (\\n    <section className=\\\"cart-page\\\">\\n      <h2>Your Shopping Cart</h2>\\n      <div className=\\\"cart-items-list\\\">\\n        {cartItems.map(item => (\\n          <CartItem key={item.productId} item={item} />\\n        ))}\\n      </div>\\n      <div className=\\\"cart-summary\\\">\\n        <p className=\\\"cart-total\\\">Total: <span>${cartTotal.toFixed(2)}</span></p>\\n        <button onClick={clearCart} className=\\\"button secondary-button\\\">Clear Cart</button>\\n        <Link to=\\\"/checkout\\\" className=\\\"button primary-button\\\">Proceed to Checkout</Link>\\n      </div>\\n    </section>\\n  );\\n}\\n\\nexport default Cart;\\n\",\n          \"Login.jsx\": \"import React from 'react';\\nimport { Link } from 'react-router-dom';\\nimport AuthForm from '../components/AuthForm';\\n\\nfunction Login() {\\n  return (\\n    <section className=\\\"login-page auth-page\\\">\\n      <AuthForm type=\\\"login\\\" />\\n      <p>Don't have an account? <Link to=\\\"/register\\\">Register here</Link></p>\\n    </section>\\n  );\\n}\\n\\nexport default Login;\\n\",\n          \"Register.jsx\": \"import React from 'react';\\nimport { Link } from 'react-router-dom';\\nimport AuthForm from '../components/AuthForm';\\n\\nfunction Register() {\\n  return (\\n    <section className=\\\"register-page auth-page\\\">\\n      <AuthForm type=\\\"register\\\" />\\n      <p>Already have an account? <Link to=\\\"/login\\\">Login here</Link></p>\\n    </section>\\n  );\\n}\\n\\nexport default Register;\\n\",\n          \"Profile.jsx\": \"import React, { useState, useEffect } from 'react';\\nimport { useNavigate, Link } from 'react-router-dom';\\nimport { useAuth } from '../hooks/useAuth';\\nimport ProfileEditForm from '../components/ProfileEditForm';\\nimport ProfileAddressManager from '../components/ProfileAddressManager';\\nimport LoadingSpinner from '../components/LoadingSpinner';\\nimport ErrorMessage from '../components/ErrorMessage';\\nimport { api } from '../utils/api';\\n\\nfunction Profile() {\\n  const { user, logout, loading: authLoading, error: authError, setUser } = useAuth();\\n  const navigate = useNavigate();\\n  const [profileLoading, setProfileLoading] = useState(true);\\n  const [profileError, setProfileError] = useState(null);\\n  const [activeTab, setActiveTab] = useState('details'); // 'details' or 'addresses'\\n\\n  useEffect(() => {\\n    const fetchProfile = async () => {\\n      if (!user?.userId) return; // Only fetch if userId is available\\n      setProfileLoading(true);\\n      setProfileError(null);\\n      try {\\n        const response = await api.get('/v1/profile');\\n        setUser(response.data); // Update user in AuthContext with full profile\\n      } catch (err) {\\n        setProfileError(err.response?.data?.message || 'Failed to fetch profile details.');\\n        console.error('Fetch profile error:', err);\\n      } finally {\\n        setProfileLoading(false);\\n      }\\n    };\\n\\n    if (user?.userId) {\\n      fetchProfile();\\n    } else if (!authLoading) { // If not loading auth and no user, means not logged in\\n      setProfileLoading(false);\\n    }\\n  }, [user?.userId, authLoading, setUser]);\\n\\n  const handleLogout = () => {\\n    logout();\\n    navigate('/'); // Redirect to home after logout\\n  };\\n\\n  if (authLoading || profileLoading) return <LoadingSpinner />;\\n  if (authError || profileError) return <ErrorMessage message={authError || profileError} />;\\n\\n  if (!user) {\\n    return (\\n      <section className=\\\"profile-page\\\">\\n        <h2>Not Logged In</h2>\\n        <p>Please <Link to=\\\"/login\\\">login</link> to view your profile.</p>\\n      </section>\\n    );\\n  }\\n\\n  return (\\n    <section className=\\\"profile-page\\\">\\n      <h2>My Profile</h2>\\n\\n      <div className=\\\"profile-tabs\\\">\\n        <button \\n          className={`button tab-button ${activeTab === 'details' ? 'active-tab' : ''}`}\\n          onClick={() => setActiveTab('details')}\\n        >\\n          Personal Details\\n        </button>\\n        <button \\n          className={`button tab-button ${activeTab === 'addresses' ? 'active-tab' : ''}`}\\n          onClick={() => setActiveTab('addresses')}\\n        >\\n          Addresses\\n        </button>\\n      </div>\\n\\n      <div className=\\\"profile-content\\\">\\n        {activeTab === 'details' && (\\n          <div className=\\\"profile-section\\\">\\n            <p><strong>Name:</strong> {user.firstName} {user.lastName}</p>\\n            <p><strong>Email:</strong> {user.email}</p>\\n            <p><Link to=\\\"/orders\\\">View Order History</Link></p>\\n            <ProfileEditForm onSaveSuccess={() => setProfileError(null)} />\\n          </div>\\n        )}\\n\\n        {activeTab === 'addresses' && (\\n          <div className=\\\"profile-section\\\">\\n            <ProfileAddressManager />\\n          </div>\\n        )}\\n      </div>\\n\\n      <button onClick={handleLogout} className=\\\"button secondary-button\\\">Logout</button>\\n    </section>\\n  );\\n}\\n\\nexport default Profile;\\n\",\n          \"Checkout.jsx\": \"import React, { useState, useEffect } from 'react';\\nimport { useNavigate } from 'react-router-dom';\\nimport AddressForm from '../components/AddressForm';\\nimport PaymentForm from '../components/PaymentForm';\\nimport { useCart } from '../hooks/useCart';\\nimport { useAuth } from '../hooks/useAuth';\\nimport { api } from '../utils/api';\\nimport ErrorMessage from '../components/ErrorMessage';\\nimport LoadingSpinner from '../components/LoadingSpinner';\\n\\nfunction Checkout() {\\n  const navigate = useNavigate();\\n  const { user } = useAuth();\\n  const { cartItems, cartTotal, clearCart, fetchCart } = useCart();\\n  const [step, setStep] = useState(1); // 1: Address, 2: Payment, 3: Review\\n  const [selectedShippingAddressId, setSelectedShippingAddressId] = useState(null);\\n  const [paymentInfo, setPaymentInfo] = useState(null);\\n  const [orderProcessing, setOrderProcessing] = useState(false);\\n  const [checkoutError, setCheckoutError] = useState(null);\\n  const [userAddresses, setUserAddresses] = useState([]);\\n  const [addressesLoading, setAddressesLoading] = useState(true);\\n  const [addressesError, setAddressesError] = useState(null);\\n\\n  useEffect(() => {\\n    if (!user) {\\n      // Redirect to login if not authenticated\\n      navigate('/login?redirect=/checkout');\\n      return;\\n    }\\n    fetchCart(); // Ensure cart is up-to-date\\n\\n    const fetchUserAddresses = async () => {\\n      setAddressesLoading(true);\\n      setAddressesError(null);\\n      try {\\n        const response = await api.get('/v1/profile'); // Fetch full profile for addresses\\n        setUserAddresses(response.data.addresses || []);\\n        const defaultAddress = response.data.addresses?.find(addr => addr.isDefault);\\n        if (defaultAddress) {\\n          setSelectedShippingAddressId(defaultAddress.id);\\n        }\\n      } catch (err) {\\n        setAddressesError(err.response?.data?.message || 'Failed to fetch addresses.');\\n        console.error('Fetch addresses error:', err);\\n      } finally {\\n        setAddressesLoading(false);\\n      }\\n    };\\n    fetchUserAddresses();\\n  }, [user, navigate, fetchCart]);\\n\\n  const handleSaveAddress = async (addressData) => {\\n    setCheckoutError(null);\\n    try {\\n      const response = await api.post('/v1/profile/addresses', addressData);\\n      setUserAddresses((prev) => [...prev, response.data.address]);\\n      setSelectedShippingAddressId(response.data.address.id);\\n      setStep(2);\\n    } catch (err) {\\n      setCheckoutError(err.response?.data?.message || 'Failed to save new address.');\\n      console.error('Save address error:', err);\\n    }\\n  };\\n\\n  const handlePaymentSave = (payment) => {\\n    setPaymentInfo(payment);\\n    setStep(3);\\n  };\\n\\n  const handlePlaceOrder = async () => {\\n    if (!selectedShippingAddressId || !paymentInfo || cartItems.length === 0) {\\n      setCheckoutError('Please complete all steps and ensure your cart is not empty.');\\n      return;\\n    }\\n\\n    setOrderProcessing(true);\\n    setCheckoutError(null);\\n\\n    try {\\n      const orderData = {\\n        shippingAddressId: selectedShippingAddressId,\\n        paymentMethodType: paymentInfo.paymentMethodType,\\n        paymentDetails: paymentInfo.paymentDetails,\\n      };\\n\\n      const response = await api.post('/v1/checkout', orderData);\\n      console.log('Order placed:', response.data);\\n\\n      clearCart(); // Clear cart after successful order\\n      navigate(`/orders/${response.data.orderId}`); // Redirect to order detail or success page\\n    } catch (err) {\\n      setCheckoutError(err.response?.data?.message || 'Failed to place order. Please try again.');\\n      console.error(err);\\n    } finally {\\n      setOrderProcessing(false);\\n    }\\n  };\\n\\n  const currentShippingAddress = userAddresses.find(addr => addr.id === selectedShippingAddressId);\\n\\n  if (addressesLoading) return <LoadingSpinner />;\\n  if (addressesError) return <ErrorMessage message={addressesError} />;\\n\\n  return (\\n    <section className=\\\"checkout-page\\\">\\n      <h2>Checkout</h2>\\n      {checkoutError && <ErrorMessage message={checkoutError} />}\\n\\n      <div className=\\\"checkout-steps\\\">\\n        <div className={`step ${step === 1 ? 'active' : ''}`} onClick={() => setStep(1)}>1. Shipping</div>\\n        <div className={`step ${step === 2 ? 'active' : ''}`} onClick={() => setStep(2)}>2. Payment</div>\\n        <div className={`step ${step === 3 ? 'active' : ''}`} onClick={() => setStep(3)}>3. Review</div>\\n      </div>\\n\\n      {step === 1 && (\\n        <div>\\n          <h3>Select Shipping Address</h3>\\n          {userAddresses.length > 0 ? (\\n            <div className=\\\"address-selection\\\">\\n              {userAddresses.map(addr => (\\n                <div key={addr.id} className={`address-option ${selectedShippingAddressId === addr.id ? 'selected' : ''}`}>\\n                  <label>\\n                    <input\\n                      type=\\\"radio\\\"\\n                      name=\\\"shippingAddress\\\"\\n                      value={addr.id}\\n                      checked={selectedShippingAddressId === addr.id}\\n                      onChange={() => setSelectedShippingAddressId(addr.id)}\\n                    />\\n                    {addr.street}, {addr.city}, {addr.state} {addr.zipCode}, 