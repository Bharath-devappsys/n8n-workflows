rid of anime that the user has added to their watchlist.\\n * It displays ShowCard components and potentially offers options to remove items.\\n *\\n * @param {object} props - The component props.\\n * @param {Array<object>} props.shows - An array of anime objects to display in the watchlist.\\n */\\nconst WatchlistGrid = ({ shows }) => {\\n  if (!shows || shows.length === 0) {\\n    return (\\n      <div className=\\\"p-6 bg-secondary dark:bg-secondary-dark rounded-lg shadow-sm text-center\\\">\\n        <p className=\\\"text-primary dark:text-white\\\">Your watchlist is empty. Start exploring!</p>\\n      </div>\\n    );\\n  }\\n\\n  return (\\n    <div className=\\\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4\\\">\\n      {shows.map((anime) => (\\n        <ShowCard\\n          key={anime.mal_id}\\n          anime={{\\n            ...anime,\\n            // Ensure all required properties for ShowCard are present\\n            mal_id: anime.mal_id || anime.id,\\n            title: anime.title || anime.title_english || anime.title_romaji || 'Unknown Title',\\n            images: anime.images || {\\n              jpg: { small: '/placeholder-image.jpg' },\\n              webp: { small: '/placeholder-image.jpg' }\\n            },\\n            score: anime.score || 0,\\n            status: anime.status || 'N/A',\\n            type: anime.type || 'N/A',\\n          }}\\n          // Additional props for WatchlistGrid context, e.g., if WatchlistButton needs to know it's in watchlist\\n          isInWatchlist={true} \\n        />\\n      ))}\\n    </div>\\n  );\\n};\\n\\nexport default WatchlistGrid;\\n\",\n    \"src/components/Dropdown.jsx\": \"import React, { useState, useEffect, useRef } from 'react';\\nimport '../assets/styles/global.css';\\n\\nconst Dropdown = ({\\n  label,\\n  options,\\n  selectedValue,\\n  onChange,\\n  placeholder = 'Select an option...', // Default placeholder text\\n}) => {\\n  const [isOpen, setIsOpen] = useState(false);\\n  const dropdownRef = useRef(null);\\n\\n  // Ensure selectedValue is handled correctly if it's not in the options initially\\n  const getDisplayText = () => {\\n    const selectedOption = options.find(option => option.id === selectedValue);\\n    return selectedOption ? selectedOption.label : placeholder;\\n  };\\n\\n  useEffect(() => {\\n    const handleClickOutside = (event) => {\\n      if (dropdownRef.current && !dropdownRef.current.contains(event.target)) {\\n        setIsOpen(false);\\n      }\\n    };\\n\\n    document.addEventListener('mousedown', handleClickOutside);\\n    return () => {\\n      document.removeEventListener('mousedown', handleClickOutside);\\n    };\\n  }, []);\\n\\n  const handleOptionClick = (optionId) => {\\n    onChange(optionId);\\n    setIsOpen(false);\\n  };\\n\\n  return (\\n    <div className=\\\"relative w-full\\\" ref={dropdownRef}>\\n      {label && (\\n        <label className=\\\"block text-sm font-medium mb-2 text-primary dark:text-white\\\">\\n          {label}\\n        </label>\\n      )}\\n      <button\\n        onClick={() => setIsOpen(!isOpen)}\\n        className=\\\"w-full p-3 rounded-lg bg-secondary dark:bg-secondary-dark border border-gray-700 cursor-pointer flex justify-between items-center transition-colors duration-200 hover:bg-accent-light dark:hover:bg-accent-dark-hover focus:outline-none focus:ring-2 focus:ring-accent dark:focus:ring-accent-dark\\\"\\n        aria-haspopup=\\\"listbox\\\"\\n        aria-expanded={isOpen}\\n      >\\n        <span className=\\\"text-sm truncate mr-2 text-primary dark:text-white\\\">\\n          {getDisplayText()}\\n        </span>\\n        <span className=\\\"material-icons text-primary dark:text-white\\\">\\n          {isOpen ? 'arrow_drop_up' : 'arrow_drop_down'}\\n        </span>\\n      </button>\\n\\n      {isOpen && (\\n        <ul\\n          className=\\\"absolute z-10 mt-1 w-full bg-secondary dark:bg-secondary-dark rounded-lg shadow-lg border border-gray-700 p-3 max-h-60 overflow-y-auto scrollbar-hide\\\"\\n          role=\\\"listbox\\\"\\n        >\\n          {options.map((option) => (\\n            <li\\n              key={option.id}\\n              onClick={() => handleOptionClick(option.id)}\\n              className=\\\"p-2 cursor-pointer rounded-md transition-colors duration-200 text-primary dark:text-white hover:bg-accent-light dark:hover:bg-accent-dark-hover\\\"\\n              role=\\\"option\\\"\\n              aria-selected={selectedValue === option.id}\\n            >\\n              {option.label}\\n            </li>\\n          ))}\\n        </ul>\\n      )}\\n    </div>\\n  );\\n};\\n\\nexport default Dropdown;\\n\",\n    \"src/components/PromotionalBanner.jsx\": \"import React, { useState } from 'react';\\nimport '../assets/styles/global.css';\\n\\nconst PromotionalBanner = ({\\n  message = 'Check out our new feature!',\\n  imageUrl = '', // Optional image URL\\n  ctaLink = '#',\\n  ctaText = 'Learn More',\\n}) => {\\n  const [isVisible, setIsVisible] = useState(true);\\n\\n  const handleClose = () => {\\n    setIsVisible(false);\\n  };\\n\\n  if (!isVisible) {\\n    return null;\\n  }\\n\\n  return (\\n    <div className=\\\"relative bg-gradient-to-br from-accent to-blue-600 dark:from-accent-dark dark:to-blue-500 text-white p-4 shadow-lg rounded-lg my-4 mx-auto max-w-screen-lg flex flex-col md:flex-row items-center justify-between space-y-3 md:space-y-0 md:space-x-4\\\">\\n      {imageUrl && (\\n        <img src={imageUrl} alt=\\\"Promotion\\\" className=\\\"w-16 h-16 object-cover rounded-md flex-shrink-0\\\" />\\n      )}\\n      <div className=\\\"flex-grow text-center md:text-left\\\">\\n        <p className=\\\"text-lg font-semibold mb-1\\\">{message}</p>\\n        {ctaText && ctaLink && (\\n          <a \\n            href={ctaLink}\\n            className=\\\"text-sm font-medium hover:underline transition-colors duration-200\\\"\\n          >\\n            {ctaText}\\n          </a>\\n        )}\\n      </div>\\n      <button\\n        onClick={handleClose}\\n        className=\\\"text-white opacity-70 hover:opacity-100 transition-opacity duration-200 focus:outline-none focus:ring-2 focus:ring-white focus:ring-opacity-50 rounded-full p-1\\\"\\n        aria-label=\\\"Close banner\\\"\\n      >\\n        <span className=\\\"material-icons\\\">close</span>\\n      </button>\\n    </div>\\n  );\\n};\\n\\nexport default PromotionalBanner;\\n\",\n    \"src/routes/AppRoutes.jsx\": \"import React from 'react';\\nimport { Routes, Route } from 'react-router-dom';\\nimport HomePage from '../pages/HomePage.jsx';\\nimport BrowsePage from '../pages/BrowsePage.jsx';\\nimport ShowDetailsPage from '../pages/ShowDetailsPage.jsx';\\nimport SearchPage from '../pages/SearchPage.jsx';\\nimport ProfilePage from '../pages/ProfilePage.jsx';\\nimport SettingsPage from '../pages/SettingsPage.jsx';\\n\\nconst AppRoutes = () => {\\n  return (\\n    <Routes>\\n      <Route path=\\\"/\\\" element={<HomePage />} />\\n      <Route path=\\\"/browse\\\" element={<BrowsePage />} />\\n      <Route path=\\\"/anime/:id\\\" element={<ShowDetailsPage />} />\\n      <Route path=\\\"/search\\\" element={<SearchPage />} />\\n      <Route path=\\\"/profile\\\" element={<ProfilePage />} />\\n      <Route path=\\\"/settings\\\" element={<SettingsPage />} />\\n      {/* Add a 404 Not Found route here if desired */}\\n    </Routes>\\n  );\\n};\\n\\nexport default AppRoutes;\\n\",\n    \"src/assets/styles/global.css\": \"/* Base Styles */\\nbody {\\n  font-family: 'Roboto', sans-serif;\\n  line-height: 1.6;\\n  background-color: #F8F9FA; /* Light mode primary background */\\n  color: #212529; /* Light mode primary text */\\n  overflow-y: scroll; /* Ensures consistent scrollbar behavior */\\n  scroll-behavior: smooth; /* For smooth scrolling links */\\n}\\n\\n.dark body {\\n  background-color: #121212; /* Dark mode primary background */\\n  color: #E0E0E0; /* Dark mode primary text */\\n}\\n\\nh1, h2, h3, h4, h5, h6 {\\n  font-family: 'Inter', sans-serif;\\n  font-weight: 700; /* Bold for headings */\\n}\\n\\nh1 {\\n  font-size: 2.5rem; /* Example size */\\n}\\n\\nh2 {\\n  font-size: 2rem; /* Example size */\\n}\\n\\n/* Utility Classes (Tailwind handles most, but custom ones can go here) */\\n.scrollbar-hide {\\n  -ms-overflow-style: none;  /* IE and Edge */\\n  scrollbar-width: none;  /* Firefox */\\n}\\n\\n.scrollbar-hide::-webkit-scrollbar { \\n  display: none;  /* Chrome, Safari, Opera */\\n}\\n\\n/* Animations */\\n@keyframes shimmer {\\n  0% {\\n    transform: translateX(-100%);\\n  }\\n  100% {\\n    transform: translateX(100%);\\n  }\\n}\\n\\n.animate-shimmer {\\n  animation: shimmer 2s infinite;\\n}\\n\\n/* Responsive Typography */\\n@media (max-width: 640px) {\\n  h1 {\\n    font-size: 2rem;\\n  }\\n  h2 {\\n    font-size: 1.75rem;\\n  }\\n}\\n\\n/* Color Palette Utility Classes */\\n/* Light Mode */\\n.bg-background { background-color: #F8F9FA; } /* Off-white */\\n.bg-secondary { background-color: #FFFFFF; } /* White */\\n.text-primary { color: #212529; } /* Dark Grey */\\n.text-secondary { color: #6c757d; } /* Muted Grey */\\n.bg-accent { background-color: #007bff; } /* Muted Blue */\\n.text-accent { color: #007bff; }\\n.hover\\\\:bg-accent:hover { background-color: #0056b3; }\\n.hover\\\\:text-accent:hover { color: #0056b3; }\\n.focus\\\\:ring-accent {\\n  box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.5); \\n}\\n\\n/* Dark Mode */\\n.dark .bg-background-dark { background-color: #121212; } /* Deep Charcoal */\\n.dark .bg-secondary-dark { background-color: #1E1E1E; } /* Dark Grey */\\n.dark .text-primary-dark { color: #E0E0E0; } /* Light Grey */\\n.dark .text-secondary-dark { color: #A0A0A0; } /* Muted Dark Grey */\\n.dark .bg-accent-dark { background-color: #17a2b8; } /* Brighter Teal/Cyan */\\n.dark .text-accent-dark { color: #17a2b8; }\\n.dark .hover\\\\:bg-accent-dark:hover { background-color: #0f7a8b; }\\n.dark .hover\\\\:text-accent-dark:hover { color: #0f7a8b; }\\n.dark .focus\\\\:ring-accent-dark {\\n  box-shadow: 0 0 0 3px rgba(23, 162, 184, 0.5);\\n}\\n\\n/* Accent Variants for Hover/Focus */\\n.bg-accent-light { background-color: #e7f3ff; } /* Light blue for hover */\\n.dark .hover\\\\:bg-accent-dark-hover { background-color: #2c3e50; } /* Dark hover background */\\n\",\n    \"src/utils/api.js\": \"import axios from 'axios';\\n\\n// Use the provided Jikan API v4 endpoint\\nconst JIKAN_API_BASE_URL = 'https://api.jikan.moe/v4';\\n\\n// Helper function for making GET requests with error handling\\nconst makeGetRequest = async (endpoint, params = {}) => {\\n  try {\\n    const response = await axios.get(`${JIKAN_API_BASE_URL}${endpoint}`, {\\n      params,\\n    });\\n    // Jikan API v4 returns data within a 'data' property\\n    return response.data;\\n  } catch (error) {\\n    console.error(`Error fetching data from ${endpoint}:`, error.response?.data || error.message);\\n    // Rethrow the error to be handled by the component\\n    throw error;\\n  }\\n};\\n\\n/**\\n * Fetches a list of top anime (e.g., trending).\\n * @param {object} params - Additional parameters for the API request (e.g., page, limit).\\n * @returns {Promise<object>} - The response data from the API.\\n */\\nexport const fetchTrendingAnime = async (params = { page: 1, limit: 25 }) => {\\n  // Jikan API endpoint for top anime\\n  const response = await makeGetRequest('/top/anime', params);\\n  return response; // Contains 'data' and 'pagination'\\n};\\n\\n/**\\n * Fetches seasonal anime for the current season.\\n * @param {string} season - The season (e.g., 'winter', 'spring', 'summer', 'fall').\\n * @param {number} year - The year.\\n * @param {object} params - Additional parameters for the API request (e.g., page, limit).\\n * @returns {Promise<object>} - The response data from the API.\\n */\\nexport const fetchSeasonalAnime = async (season = 'upcoming', year = new Date().getFullYear(), params = { page: 1, limit: 25 }) => {\\n  // Jikan API endpoint for seasonal anime\\n  const response = await makeGetRequest(`/seasons/${year}/${season}`, params);\\n  return response; // Contains 'data' and 'pagination'\\n};\\n\\n/**\\n * Fetches detailed information for a specific anime by its ID.\\n * @param {number|string} id - The MAL ID of the anime.\\n * @returns {Promise<object>} - The detailed anime object.\\n */\\nexport const fetchAnimeDetails = async (id) => {\\n  const response = await makeGetRequest(`/anime/${id}`);\\n  return response.data; // Contains the detailed anime object\\n};\\n\\n/**\\n * Fetches search results for anime based on a query.\\n * @param {string} query - The search term.\\n * @param {object} params - Additional parameters for the API request (e.g., page, limit).\\n * @returns {Promise<object>} - The response data from the API.\\n */\\nexport const searchAnime = async (query, params = { page: 1, limit: 25 }) => {\\n  const response = await makeGetRequest('/anime', { q: query, ...params });\\n  return response; // Contains 'data' and 'pagination'\\n};\\n\\n/**\\n * Fetches a list of anime based on various filters and sort orders.\\n * @param {object} options - Options object.\\n * @param {number} [options.page=1] - The current page number.\\n * @param {number} [options.limit=25] - The number of items per page.\\n * @param {object} [options.filters={}] - An object containing filter criteria (e.g., genres, types, year).\\n * @param {string} [options.sort='score'] - The sort order (e.g., 'score', 'popularity').\\n * @returns {Promise<object>} - The response data from the API.\\n */\\nexport const fetchAnimeList = async ({ page = 1, limit = 25, filters = {}, sort = 'score' }) => {\\n  const queryParams = {\\n    page,\\n    limit,\\n    order_by: sort,\\n    sort: 'desc', // Default to descending for most sorting types\\n  };\\n\\n  // Add filters to queryParams\\n  if (filters.genres && filters.genres.length > 0) {\\n    queryParams.genres = filters.genres.join(',');\\n  }\\n  if (filters.types && filters.types.length > 0) {\\n    queryParams.type = filters.types.join(',');\\n  }\\n  // Jikan API uses start_date and end_date for year filtering\\n  if (filters.year && filters.year.min) {\\n    queryParams.start_date = `${filters.year.min}-01-01`;\\n  }\\n  if (filters.year && filters.year.max) {\\n    queryParams.end_date = `${filters.year.max}-12-31`;\\n  }\\n  // Rating is handled by score, but might need mapping if a separate rating filter exists\\n  if (filters.rating && filters.rating.min) {\\n    // Assuming score filter directly maps to score\\n    // Note: Jikan API might not directly support range filtering on score this way.\\n    // This might require fetching all and filtering client-side if not supported.\\n    // For now, we'll omit this specific filter if not directly supported by /anime endpoint params.\\n  }\\n\\n  // Handle specific sort orders if needed (e.g., 'title' might require 'sort: asc')\\n  if (sort === 'title') {\\n    queryParams.sort = 'asc';\\n  }\\n\\n  const response = await makeGetRequest('/anime', queryParams);\\n  return response; // Contains 'data' and 'pagination'\\n};\\n\\n/**\\n * Fetches trailer data for a specific anime by its ID.\\n * This might involve fetching anime details and extracting the trailer URL,\\n * or a separate endpoint if available.\\n * @param {number|string} id - The MAL ID of the anime.\\n * @returns {Promise<object|null>} - The trailer data or null if not found.\\n */\\nexport const fetchAnimeTrailer = async (id) => {\\n  try {\\n    const details = await fetchAnimeDetails(id);\\n    // Jikan API includes trailer information within the anime details object\\n    return details.trailer;\\n  } catch (error) {\\n    console.error(`Error fetching trailer for anime ${id}:`, error.message);\\n    // Return null or a specific error indicator if trailer fetching fails\\n    return null;\\n  }\\n};\\n\\n/**\\n * Fetches user profile data.\\n * @param {string} username - The username of the profile 