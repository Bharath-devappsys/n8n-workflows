        "jsCode": "/**\n * 🔥 Ultimate JSON Recovery Parser for AI Output + JSON File Stringifier\n * - Extracts JSON object from AI output\n * - Repairs missing commas, trailing commas, escape issues\n * - Detects JSON-based files (ex: package.json) and converts to a JSON string\n */\n\nconst raw = $json.output;\n\nif (!raw || typeof raw !== \"string\") {\n  return [{ json: { error: \"No 'output' string found\" } }];\n}\n\n// STEP 1 — Extract only the JSON object inside the fences\nlet cleaned = raw;\n\n// remove ```json fences\ncleaned = cleaned.replace(/```json/gi, \"\").replace(/```/g, \"\").trim();\n\n// extract first { ... } block\nconst match = cleaned.match(/\\{[\\s\\S]*\\}/);\nif (!match) {\n  return [{ json: { error: \"No JSON-like object found\" } }];\n}\ncleaned = match[0];\n\n// STEP 2 — Basic cleanup\ncleaned = cleaned\n  .replace(/\\\\(?![\"\\\\\\/bfnrtu])/g, \"\\\\\\\\\")     // fix invalid backslashes\n  .replace(/[\\u0000-\\u001F]/g, \"\")            // remove control chars\n  .replace(/\\r?\\n/g, \"\\\\n\");                  // convert newlines\n\n// STEP 3 — Fix missing commas between file entries\ncleaned = cleaned.replace(/\\\"\\s*\\n\\s*\\\"/g, \"\\\",\\n  \\\"\");\n\n// STEP 4 — Fix trailing commas\ncleaned = cleaned.replace(/,\\s*}/g, \"}\").replace(/,\\s*]/g, \"]\");\n\n// STEP 5 — Try parsing\nlet parsed = null;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (err) {\n  return [\n    {\n      json: {\n        error: \"JSON parse failed after repairs\",\n        message: err.message,\n        cleaned_preview: cleaned.slice(0, 800)\n      }\n    }\n  ];\n}\n\n// ----------------------------------------------------------\n// ⭐ STEP 6 — Convert JSON-file objects into stringified JSON\n// ----------------------------------------------------------\n\nconst jsonFileRegex = /\\.json$/i;\n\nfor (const key of Object.keys(parsed)) {\n  const value = parsed[key];\n\n  if (jsonFileRegex.test(key)) {\n\n    // 💡 If already a string → LEAVE IT AS IS\n    if (typeof value === \"string\") {\n      continue;\n    }\n\n    // 💡 If it's an object → convert to pretty JSON string\n    if (typeof value === \"object\" && !Array.isArray(value)) {\n      parsed[key] = JSON.stringify(value, null, 2);\n    }\n  }\n}\n\n// Return final result\nreturn [{ json: { cleaned_folder_json: parsed } }];"
