\\nexport const useAuth = () => {\\n  const context = useContext(AuthContext);\\n  const navigate = useNavigate();\\n\\n  if (!context) {\\n    throw new Error('useAuth must be used within an AuthProvider');\\n  }\\n\\n  const { user, setUser, loading, setLoading, error, setError } = context;\\n\\n  // Check for existing token on initial load and fetch user profile\\n  useEffect(() => {\\n    const checkAuthStatus = async () => {\\n      const token = getToken();\\n      if (token && !user) {\\n        try {\\n          setLoading(true);\\n          const response = await api.get('/v1/profile'); // Fetch full user profile\\n          setUser(response.data); // Set user with full profile data\\n        } catch (err) {\\n          console.error('Token validation failed or user data fetch error:', err);\\n          removeToken();\\n          setUser(null);\\n        } finally {\\n          setLoading(false);\\n        }\\n      } else {\\n         setLoading(false); // No token, no user, done loading, or user already set\\n      }\\n    };\\n    checkAuthStatus();\\n  }, [user, setUser, setLoading]);\\n\\n  const login = async (email, password) => {\\n    setLoading(true);\\n    setError(null);\\n    try {\\n      const { token } = await loginUser(email, password); // API returns token and userId\\n      setToken(token);\\n      const profileResponse = await api.get('/v1/profile'); // Fetch full user profile after login\\n      setUser(profileResponse.data);\\n      navigate('/profile');\\n    } catch (err) {\\n      setError(err.message || 'Login failed.');\\n      setUser(null);\\n    } finally {\\n      setLoading(false);\\n    }\\n  };\\n\\n  const register = async (email, password) => {\\n    setLoading(true);\\n    setError(null);\\n    try {\\n      const { token } = await registerUser(email, password); // API returns token and userId\\n      setToken(token);\\n      const profileResponse = await api.get('/v1/profile'); // Fetch full user profile after registration\\n      setUser(profileResponse.data);\\n      navigate('/profile');\\n    } catch (err) {\\n      setError(err.message || 'Registration failed.');\\n      setUser(null);\\n    } finally {\\n      setLoading(false);\\n    }\\n  };\\n\\n  const logout = () => {\\n    logoutUser();\\n    setUser(null);\\n    navigate('/login');\\n  };\\n\\n  return { user, login, register, logout, loading, error, setUser };\\n};\\n\",\n          \"useCart.js\": \"import { useContext, useState, useEffect, useCallback } from 'react';\\nimport { CartContext } from '../context/CartContext';\\nimport { api } from '../utils/api';\\n\\nexport const useCart = () => {\\n  const context = useContext(CartContext);\\n  if (!context) {\\n    throw new Error('useCart must be used within a CartProvider');\\n  }\\n\\n  const { \\n    cartItems, \\n    setCartItems, \\n    cartTotal, \\n    setCartTotal, \\n    loading, \\n    setLoading, \\n    error, \\n    setError \\n  } = context;\\n\\n  const fetchCart = useCallback(async () => {\\n    setLoading(true);\\n    setError(null);\\n    try {\\n      const response = await api.get('/v1/cart');\\n      setCartItems(response.data.items);\\n      setCartTotal(response.data.subtotal);\\n    } catch (err) {\\n      setError(err.response?.data?.message || 'Failed to fetch cart.');\\n      console.error('Fetch cart error:', err);\\n    } finally {\\n      setLoading(false);\\n    }\\n  }, [setCartItems, setCartTotal, setLoading, setError]);\\n\\n  const addToCart = async (productId, quantity = 1, productDetails = null) => {\\n    setError(null);\\n    try {\\n      // For optimistic UI update, add to local state immediately\\n      // This assumes the productDetails are available to update local state accurately\\n      if (productDetails) {\\n        setCartItems(prevItems => {\\n          const existingItemIndex = prevItems.findIndex(item => item.productId === productId);\\n          if (existingItemIndex > -1) {\\n            const newItems = [...prevItems];\\n            newItems[existingItemIndex].quantity += quantity;\\n            return newItems;\\n          } else {\\n            return [...prevItems, { productId, quantity, price: productDetails.price, name: productDetails.name, imageUrl: productDetails.imageUrl }];\\n          }\\n        });\\n        // Recalculate total locally for optimistic update, or wait for fetchCart\\n        setCartTotal(prevTotal => prevTotal + (productDetails.price * quantity));\\n      }\\n\\n      await api.post('/v1/cart/items', { productId, quantity });\\n      await fetchCart(); // Re-fetch actual cart from server to ensure sync\\n    } catch (err) {\\n      setError(err.response?.data?.message || 'Failed to add item to cart.');\\n      console.error('Add to cart error:', err);\\n      await fetchCart(); // Revert local state by fetching actual cart if API call failed\\n    }\\n  };\\n\\n  const removeFromCart = async (productId) => {\\n    setError(null);\\n    try {\\n      // Optimistic UI update\\n      setCartItems(prevItems => prevItems.filter(item => item.productId !== productId));\\n      setCartTotal(prevTotal => {\\n        const removedItem = cartItems.find(item => item.productId === productId);\\n        return removedItem ? prevTotal - (removedItem.price * removedItem.quantity) : prevTotal;\\n      });\\n\\n      await api.delete(`/v1/cart/items/${productId}`);\\n      await fetchCart();\\n    } catch (err) {\\n      setError(err.response?.data?.message || 'Failed to remove item from cart.');\\n      console.error('Remove from cart error:', err);\\n      await fetchCart();\\n    }\\n  };\\n\\n  const updateQuantity = async (productId, newQuantity) => {\\n    if (newQuantity < 1) {\\n      await removeFromCart(productId);\\n      return;\\n    }\\n\\n    setError(null);\\n    try {\\n      // Optimistic UI update\\n      setCartItems(prevItems => \\n        prevItems.map(item => \\n          item.productId === productId ? { ...item, quantity: newQuantity } : item\\n        )\\n      );\\n      setCartTotal(prevTotal => {\\n        const itemToUpdate = cartItems.find(item => item.productId === productId);\\n        return itemToUpdate ? prevTotal - (itemToUpdate.price * itemToUpdate.quantity) + (itemToUpdate.price * newQuantity) : prevTotal;\\n      });\\n\\n      await api.put(`/v1/cart/items/${productId}`, { quantity: newQuantity });\\n      await fetchCart();\\n    } catch (err) {\\n      setError(err.response?.data?.message || 'Failed to update item quantity.');\\n      console.error('Update quantity error:', err);\\n      await fetchCart();\\n    }\\n  };\\n\\n  const clearCart = async () => {\\n    setError(null);\\n    try {\\n      // As there's no single API endpoint to clear cart, we simulate by removing all items one by one.\\n      // For a real application, a dedicated '/v1/cart' DELETE endpoint would be ideal.\\n      const deletePromises = cartItems.map(item => api.delete(`/v1/cart/items/${item.productId}`));\\n      await Promise.all(deletePromises);\\n      setCartItems([]);\\n      setCartTotal(0);\\n      await fetchCart(); // Ensure server sync\\n    } catch (err) {\\n      setError(err.response?.data?.message || 'Failed to clear cart.');\\n      console.error('Clear cart error:', err);\\n      await fetchCart();\\n    }\\n  };\\n\\n  return {\\n    cartItems,\\n    addToCart,\\n    removeFromCart,\\n    updateQuantity,\\n    clearCart,\\n    cartTotal,\\n    loading,\\n    error,\\n    fetchCart\\n  };\\n};\\n\",\n          \"useProducts.js\": \"import { useState, useEffect } from 'react';\\nimport { api } from '../utils/api';\\nimport { useSearchParams } from 'react-router-dom';\\n\\nexport const useProducts = () => {\\n  const [products, setProducts] = useState([]);\\n  const [loading, setLoading] = useState(true);\\n  const [error, setError] = useState(null);\\n  const [searchParams] = useSearchParams();\\n\\n  const category = searchParams.get('category');\\n  const searchTerm = searchParams.get('