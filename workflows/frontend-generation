        "pythonCode": "import json\nimport re\n\nraw_content = _input.first().json.get(\"output\", \"\")\n\n# Extract JSON from ```json ... ``` block\njson_match = re.search(r\"```json\\s*(\\{.*\\})\\s*```\", raw_content, re.DOTALL)\nif json_match:\n    json_str = json_match.group(1)\nelse:\n    json_str = raw_content.strip()\n\n# --- Clean and attempt to auto-repair ---\n# Fix invalid escape sequences\njson_str = re.sub(r'\\\\(?![\"\\\\/bfnrtu])', r'\\\\\\\\', json_str)\n\n# Try to balance braces/brackets if truncated\nopen_braces = json_str.count('{')\nclose_braces = json_str.count('}')\nif open_braces > close_braces:\n    json_str += '}' * (open_braces - close_braces)\nopen_brackets = json_str.count('[')\nclose_brackets = json_str.count(']')\nif open_brackets > close_brackets:\n    json_str += ']' * (open_brackets - close_brackets)\n\n# --- Parse safely ---\nparsed_json = None\ntry:\n    parsed_json = json.loads(json_str)\nexcept Exception:\n    # If still not valid JSON, try forgiving parse\n    try:\n        import ast\n        parsed_json = ast.literal_eval(json_str)\n    except Exception as e:\n        # Return cleaned raw JSON so flow continues\n        return [{\"json\": {\"error\": str(e), \"raw\": json_str[:1000]}}]\n\n# --- Return n8n-compatible output ---\nif isinstance(parsed_json, dict):\n    items = [{\"json\": parsed_json}]\nelif isinstance(parsed_json, list):\n    items = [{\"json\": obj} for obj in parsed_json]\nelse:\n    items = [{\"json\": {\"data\": parsed_json}}]\n\nreturn items\n"
