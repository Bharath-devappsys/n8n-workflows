tError(null);\\n        const response = await api.get('/v1/categories');\\n        setCategories(response.data.categories);\\n      } catch (err) {\\n        setError(err.response?.data?.message || 'Failed to fetch categories.');\\n        console.error(err);\\n      } finally {\\n        setLoading(false);\\n      }\\n    };\\n    fetchCategories();\\n  }, []);\\n\\n  return { categories, loading, error };\\n};\\n\"\n        },\n        \"context\": {\n          \"AuthContext.jsx\": \"import React, { createContext, useState, useEffect } from 'react';\\nimport { getToken, removeToken } from '../utils/auth';\\nimport { api } from '../utils/api';\\n\\nexport const AuthContext = createContext();\\n\\nexport const AuthProvider = ({ children }) => {\\n  const [user, setUser] = useState(null);\\n  const [loading, setLoading] = useState(true);\\n  const [error, setError] = useState(null);\\n\\n  // Initial check for authenticated user from token\\n  useEffect(() => {\\n    const loadUser = async () => {\\n      const token = getToken();\\n      if (token) {\\n        try {\\n          const response = await api.get('/v1/profile'); \\n          setUser(response.data); // Set user with full profile data from API\\n        } catch (err) {\\n          console.error('Failed to load user from token:', err);\\n          removeToken(); // Invalid token, remove it\\n          setUser(null);\\n        } finally {\\n          setLoading(false);\\n        }\\n      } else {\\n        setLoading(false);\\n      }\\n    };\\n    loadUser();\\n  }, []);\\n\\n  const value = {\\n    user,\\n    setUser,\\n    loading,\\n    setLoading,\\n    error,\\n    setError,\\n  };\\n\\n  return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>;\\n};\\n\",\n          \"CartContext.jsx\": \"import React, { createContext, useState, useEffect, useCallback } from 'react';\\nimport { api } from '../utils/api';\\n\\nexport const CartContext = createContext();\\n\\nexport const CartProvider = ({ children }) => {\\n  const [cartItems, setCartItems] = useState([]);\\n  const [cartTotal, setCartTotal] = useState(0);\\n  const [loading, setLoading] = useState(true);\\n  const [error, setError] = useState(null);\\n\\n  // Using useCallback to memoize fetchCart for dependencies in useCart\\n  const fetchCart = useCallback(async () => {\\n    setLoading(true);\\n    setError(null);\\n    try {\\n      const response = await api.get('/v1/cart');\\n      setCartItems(response.data.items.map(item => ({...item.product, productId: item.productId, quantity: item.quantity}))); // Adapt API response to local state\\n      setCartTotal(response.data.subtotal);\\n    } catch (err) {\\n      setError(err.response?.data?.message || 'Failed to fetch cart.');\\n      console.error('Fetch cart error:', err);\\n    } finally {\\n      setLoading(false);\\n    }\\n  }, []);\\n\\n  useEffect(() => {\\n    // Load cart initially, but also keep local storage as a fallback/initial state\\n    // For a real app, persistent cart is usually backend-managed, but local storage is good for anonymous users.\\n    const localData = localStorage.getItem('cartItems');\\n    if (localData) {\\n      const parsedItems = JSON.parse(localData);\\n      setCartItems(parsedItems);\\n      setCartTotal(parsedItems.reduce((total, item) => total + item.price * item.quantity, 0));\\n    }\\n    fetchCart(); // Fetch server-side cart to reconcile/override local storage\\n  }, [fetchCart]);\\n\\n  // This useEffect ensures local storage is updated whenever cartItems change\\n  // but priority is given to server-side cart. This might cause some flicker if local storage is out of sync.\\n  useEffect(() => {\\n    localStorage.setItem('cartItems', JSON.stringify(cartItems));\\n  }, [cartItems]);\\n\\n  const addToCart = async (productId, quantity = 1, productDetails = null) => {\\n    setError(null);\\n    try {\\n      await api.post('/v1/cart/items', { productId, quantity });\\n      await fetchCart(); // Re-fetch actual cart from server to ensure sync\\n    } catch (err) {\\n      setError(err.response?.data?.message || 'Failed to add item to cart.');\\n      console.error('Add to cart error:', err);\\n    }\\n  };\\n\\n  const removeFromCart = async (productId) => {\\n    setError(null);\\n    try {\\n      await api.delete(`/v1/cart/items/${productId}`);\\n      await fetchCart();\\n    } catch (err) {\\n      setError(err.response?.data?.message || 'Failed to remove item from cart.');\\n      console.error('Remove from cart error:', err);\\n    }\\n  };\\n\\n  const updateQuantity = async (productId, newQuantity) => {\\n    if (newQuantity < 1) {\\n      await removeFromCart(productId);\\n      return;\\n    }\\n\\n    setError(null);\\n    try {\\n      await api.put(`/v1/cart/items/${productId}`, { quantity: newQuantity });\\n      await fetchCart();\\n    } catch (err) {\\n      setError(err.response?.data?.message || 'Failed to update item quantity.');\\n      console.error('Update quantity error:', err);\\n    }\\n  };\\n\\n  const clearCart = async () => {\\n    setError(null);\\n    try {\\n      // As there's no single API endpoint to clear cart, we simulate by removing all items one by one.\\n      // For a real application, a dedicated '/v1/cart' DELETE endpoint would be ideal.\\n      const deletePromises = cartItems.map(item => api.delete(`/v1/cart/items/${item.productId}`));\\n      await Promise.all(deletePromises);\\n      await fetchCart(); // Ensure server sync\\n    } catch (err) {\\n      setError(err.response?.data?.message || 'Failed to clear cart.');\\n      console.error('Clear cart error:', err);\\n    }\\n  };\\n\\n  const value = {\\n    cartItems,\\n    addToCart,\\n    removeFromCart,\\n    updateQuantity,\\n    clearCart,\\n    cartTotal,\\n    loading,\\n    error,\\n    fetchCart\\n  };\\n\\n  return <CartContext.Provider value={value}>{children}</CartContext.Provider>;\\n};\\n\"\n        },\n        \"styles\": {\n       